<script>
function recipientPermissionToggle() {
    return {
        // 🔧 可编辑：初始值（开发后默认值为关闭 false）
        enabled: false,
        saving: false,

        init() {
            // 从服务器加载当前设置
            this.loadSetting();
        },

        loadSetting() {
            fetch('/xfe_order/order/recipientPermissionStatus')
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        this.enabled = data.data.enabled;
                    }
                })
                .catch(() => {
                    console.log('[RecipientPermission] Load failed, using default');
                });
        },

        saveSetting() {
            this.saving = true;
            const formData = new FormData();
            formData.append('enabled', this.enabled ? '1' : '0');
            fetch('/xfe_order/order/recipientPermissionSave', {
                method: 'POST',
                body: formData
            })
                .then(r => r.json())
                .then(data => {
                    console.log('[RecipientPermission] Saved:', data);
                    this.saving = false;
                })
                .catch(() => {
                    console.log('[RecipientPermission] Save failed');
                    this.saving = false;
                });
        }
    };
}
</script>

