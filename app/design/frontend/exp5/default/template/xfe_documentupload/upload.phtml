<?php

/**
 * Document Upload Page Template
 *
 * @var $this XFE_DocumentUpload_Block_Upload_Form
 */
$_uploadUrl        = $this->getUploadUrl();
$_docTypesUrl      = $this->getDocumentTypesUrl();
$_carriers         = $this->getCarrierOptions();
$_allDocTypesJson  = $this->getAllDocumentTypesJson();
$_maxFileSize      = $this->getMaxFileSize();
$_maxFileSizeKb    = $this->getMaxFileSizeKb();
$_acceptExts       = $this->getAcceptedExtensions();
?>
<div class="xfe-document-upload container py-4"
	x-data="documentUpload()"
	x-init="init('<?php echo $_uploadUrl ?>', '<?php echo $_docTypesUrl ?>', <?php echo $_allDocTypesJson ?>, <?php echo $_maxFileSize ?>)">

	<!-- Page Title -->
	<div class="mb-4">
		<h1 class="h3 fw-bold"><?php echo $this->__('Upload Document') ?></h1>
		<p class="text-muted mb-0">
			<?php echo $this->__('Upload customs documents, invoices, and certificates for your shipments.') ?>
		</p>
	</div>

	<!-- Upload Form Card -->
	<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
		<div class="card-body p-4">
			<form @submit.prevent="submitUpload()" enctype="multipart/form-data">

				<!-- Carrier Select -->
				<div class="mb-3">
					<label class="form-label fw-semibold" for="carrier_code">
						<?php echo $this->__('Carrier') ?> <span class="text-danger">*</span>
					</label>
					<select class="form-select" id="carrier_code"
						x-model="carrier"
						@change="onCarrierChange()"
						required>
						<option value=""><?php echo $this->__('— Select Carrier —') ?></option>
						<?php foreach ($_carriers as $_option): ?>
							<option value="<?php echo $this->escapeHtml($_option['value']) ?>">
								<?php echo $this->escapeHtml($_option['label']) ?>
							</option>
						<?php endforeach; ?>
					</select>
				</div>

				<!-- Parcel Number -->
				<div class="mb-3">
					<label class="form-label fw-semibold" for="parcel_number">
						<?php echo $this->__('Parcel Number') ?> <span class="text-danger">*</span>
					</label>
					<input type="text" class="form-control" id="parcel_number"
						x-model="parcelNumber"
						placeholder="<?php echo $this->__('e.g. EY607748960FR') ?>"
						required>
				</div>

				<!-- Document Type Select -->
				<div class="mb-3">
					<label class="form-label fw-semibold" for="document_type">
						<?php echo $this->__('Document Type') ?> <span class="text-danger">*</span>
					</label>
					<select class="form-select" id="document_type"
						x-model="documentType"
						:disabled="!carrier || docTypeOptions.length === 0"
						required>
						<option value=""><?php echo $this->__('— Select Document Type —') ?></option>
						<template x-for="opt in docTypeOptions" :key="opt.value">
							<option :value="opt.value" x-text="opt.label"></option>
						</template>
					</select>
				</div>

				<!-- File Input -->
				<div class="mb-3">
					<label class="form-label fw-semibold" for="file_input">
						<?php echo $this->__('File') ?> <span class="text-danger">*</span>
					</label>
					<div class="xfe-upload-dropzone p-4 text-center"
						:class="{ 'xfe-dropzone-active': isDragging }"
						@dragover.prevent="isDragging = true"
						@dragleave.prevent="isDragging = false"
						@drop.prevent="onFileDrop($event)"
						@click="$refs.fileInput.click()">
						<input type="file" class="d-none"
							x-ref="fileInput"
							id="file_input"
							name="file"
							accept="<?php echo $_acceptExts ?>"
							@change="onFileChange($event)"
							required>
						<div x-show="!selectedFile">
							<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40"
								fill="currentColor" class="bi bi-cloud-arrow-up text-muted mb-2"
								viewBox="0 0 16 16">
								<path fill-rule="evenodd" d="M4.406 3.342A5.53 5.53 0 0 1 8 2c2.69 0 4.923 2 5.166 4.579C14.758 6.804 16 8.137 16 9.773 16 11.569 14.502 13 12.687 13H3.781C1.708 13 0 11.366 0 9.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383z" />
								<path fill-rule="evenodd" d="M7.646 4.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707V14.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708z" />
							</svg>
							<p class="mb-1 text-muted">
								<?php echo $this->__('Click or drag file here to upload') ?>
							</p>
							<small class="text-muted">
								<?php echo $this->__('Accepted: PDF, JPG, PNG, TIFF — Max %s KB', $_maxFileSizeKb) ?>
							</small>
						</div>
						<div x-show="selectedFile" class="d-flex align-items-center justify-content-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
								fill="currentColor" class="bi bi-file-earmark-check text-success"
								viewBox="0 0 16 16">
								<path d="M10.854 7.854a.5.5 0 0 0-.708-.708L7.5 9.793 6.354 8.646a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0z" />
								<path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z" />
							</svg>
							<span x-text="selectedFile ? selectedFile.name : ''"></span>
							<small class="text-muted"
								x-text="selectedFile ? '(' + formatFileSize(selectedFile.size) + ')' : ''"></small>
							<button type="button" class="btn btn-sm btn-outline-danger ms-2"
								@click.stop="clearFile()"
								title="<?php echo $this->__('Remove') ?>">
								&times;
							</button>
						</div>
					</div>
				</div>

				<!-- Parcel Number List (Optional) -->
				<div class="mb-4">
					<label class="form-label fw-semibold" for="parcel_number_list">
						<?php echo $this->__('Additional Parcel Numbers') ?>
						<small class="text-muted fw-normal">(<?php echo $this->__('optional') ?>)</small>
					</label>
					<input type="text" class="form-control" id="parcel_number_list"
						x-model="parcelNumberList"
						placeholder="<?php echo $this->__('Comma-separated parcel numbers for multi-parcel shipments') ?>">
				</div>

				<!-- Submit Button -->
				<button type="submit" class="btn btn-primary px-4"
					:disabled="loading || !selectedFile"
					style="border-radius: 8px;">
					<span x-show="!loading">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
							fill="currentColor" class="bi bi-upload me-1"
							viewBox="0 0 16 16" style="vertical-align: -2px;">
							<path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5" />
							<path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708z" />
						</svg>
						<?php echo $this->__('Upload') ?>
					</span>
					<span x-show="loading">
						<span class="spinner-border spinner-border-sm me-1" role="status"></span>
						<?php echo $this->__('Uploading...') ?>
					</span>
				</button>
			</form>
		</div>
	</div>

	<!-- Success Alert -->
	<div x-show="result && result.success" class="alert alert-success d-flex align-items-start gap-2"
		style="border-radius: 10px;" x-cloak>
		<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
			class="bi bi-check-circle-fill flex-shrink-0 mt-1" viewBox="0 0 16 16">
			<path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
		</svg>
		<div>
			<strong><?php echo $this->__('Upload Successful!') ?></strong>
			<p class="mb-0 mt-1" x-show="result.document_id">
				<?php echo $this->__('Document ID') ?>:
				<code x-text="result.document_id"></code>
			</p>
		</div>
	</div>

	<!-- Error Alert -->
	<div x-show="errors.length > 0" class="alert alert-danger" style="border-radius: 10px;" x-cloak>
		<div class="d-flex align-items-start gap-2 mb-2">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
				class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1" viewBox="0 0 16 16">
				<path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
			</svg>
			<strong><?php echo $this->__('Upload Failed') ?></strong>
		</div>
		<ul class="mb-0 ps-4">
			<template x-for="(err, idx) in errors" :key="idx">
				<li x-text="err"></li>
			</template>
		</ul>
	</div>
</div>