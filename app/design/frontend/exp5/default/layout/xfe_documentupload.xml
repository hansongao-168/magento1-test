<?xml version="1.0"?>
<layout version="0.1.0">
    <!-- Frontend upload page -->
    <xfe_documentupload_upload_index translate="label">
        <label>Document Upload</label>
        <reference name="content">
            <block type="xfe_documentupload/upload_form" name="document.upload.form"
                   template="xfe_documentupload/upload.phtml" />
        </reference>
        <reference name="head">
            <action method="addItem">
                <type>skin_css</type>
                <name>css/xfe_documentupload.css</name>
            </action>
            <action method="addItem">
                <type>skin_js</type>
                <name>js/xfe_documentupload.js</name>
            </action>
            <action method="addItem">
                <type>js</type>
                <name>https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js</name>
            </action>
        </reference>
    </xfe_documentupload_upload_index>
</layout>
