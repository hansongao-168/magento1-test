<?xml version="1.0"?>
    <!--
        OAuth2 storefront account navigation + page layouts.

        IMPORTANT: the full action name for /oauth2/client/index is
            "xfeoauth2_client_index"  (NOT "oauth2_client_index")
        because Magento's getFullActionName() is built from
        getRequestedRouteName() (= the <routers><xfeoauth2> tag name),
        not from frontName. Declaring <oauth2_client_index> here is a
        silent no-op - the layout node is never merged.

        We define <my.account.wrapper> ourselves because exp5's
        customer_account.xml re-declares the <customer_account> handle
        and silently strips the wrapper block that rwd's customer.xml
        provides. We do NOT use <update handle="customer_account_index"/>
        because that would inject the customer dashboard block.
    -->
    <layout version="0.0.1">

        <!-- Add a nav link on every customer account page -->
        <customer_account>
            <reference name="customer_account_navigation">
                <action method="addLink" translate="label" module="xfeoauth2">
                    <name>oauth2_clients</name>
                    <path>oauth2/client/index</path>
                    <label>My API Clients</label>
                </action>
            </reference>
        </customer_account>

        <!-- /oauth2/client/index : list page -->
        <xfeoauth2_client_index>
            <update handle="customer_account"/>
            <reference name="root">
                <action method="setHeaderTitle" translate="title" module="xfeoauth2"><title>My API Clients</title></action>
            </reference>
            <reference name="content">
                <block type="page/html_wrapper" name="my.account.wrapper" translate="label">
                    <label>My Account Wrapper</label>
                    <action method="setElementClass"><value>my-account</value></action>
                </block>
            </reference>
            <reference name="my.account.wrapper">
                <block type="xfeoauth2/customer_oauth2Client" name="customer.oauth2.client.list"
                       template="xfeoauth2/customer/oauth2client/list.phtml"/>
            </reference>
        </xfeoauth2_client_index>

        <!-- /oauth2/client/new : new client form -->
        <xfeoauth2_client_new>
            <update handle="customer_account"/>
            <reference name="root">
                <action method="setHeaderTitle" translate="title" module="xfeoauth2"><title>New API Client</title></action>
            </reference>
            <reference name="content">
                <block type="page/html_wrapper" name="my.account.wrapper" translate="label">
                    <label>My Account Wrapper</label>
                    <action method="setElementClass"><value>my-account</value></action>
                </block>
            </reference>
            <reference name="my.account.wrapper">
                <block type="xfeoauth2/customer_oauth2Client" name="customer.oauth2.client.new"
                       template="xfeoauth2/customer/oauth2client/new.phtml"/>
            </reference>
        </xfeoauth2_client_new>

    </layout>