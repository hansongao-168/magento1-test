                </thead>
                <tbody id="xfe-orders-body">
                    <tr id="xfe-loading-row">
                        <td colspan="6" class="a-center">
                            <div style="padding: 20px;">
                                <img src="<?php echo $this->getSkinUrl('images/opc-ajax-loader.gif') ?>" alt="Loading">
