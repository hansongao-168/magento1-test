<?php
/**
 * My API Clients - list page
 *
 * @var $this XFE_OAuth2_Block_Customer_OAuth2Client
 * @var Mage_Core_Model_Resource_Collection_Abstract $clients
 */
$clients       = $this->getClients();
$showSecretId  = $this->getShowSecretClientId();
?>
<div class="my-account my-oauth2-clients">
    <div class="page-title">
        <h1><?php echo $this->__('My API Clients') ?></h1>
    </div>

    <?php if ($showSecretId): ?>
        <?php $secret = $this->getNewSecret($showSecretId); ?>
        <?php if ($secret): ?>
            <div class="oauth2-secret-box" style="border:2px solid #f0ad4e;background:#fcf8e3;padding:16px;margin-bottom:20px;">
                <h2 style="margin-top:0;color:#8a6d3b;">
                    <?php echo $this->__('Save your Client Secret now') ?>
                </h2>
                <p><?php echo $this->__('This is the only time the secret will be displayed. Store it securely.') ?></p>
                <p>
                    <strong><?php echo $this->__('Client ID') ?>:</strong>
                    <code style="user-select:all"><?php echo $this->escapeHtml($showSecretId) ?></code>
                </p>
                <p>
                    <strong><?php echo $this->__('Client Secret') ?>:</strong>
                    <code style="user-select:all"><?php echo $this->escapeHtml($this->formatSecret($secret)) ?></code>
                </p>
                <p>
                    <em><?php echo $this->__('After leaving this page the secret cannot be recovered.') ?></em>
                </p>
            </div>
        <?php endif; ?>
    <?php endif; ?>

    <p>
        <a href="<?php echo $this->getNewUrl() ?>" class="button">
            <?php echo $this->__('Create New API Client') ?>
        </a>
    </p>

    <?php if ($clients->getSize()): ?>
        <table class="data-table" id="my-oauth2-clients-table" style="width:100%;border-collapse:collapse;">
            <thead>
                <tr>
                    <th><?php echo $this->__('Name') ?></th>
                    <th><?php echo $this->__('Client ID') ?></th>
                    <th><?php echo $this->__('Grant Types') ?></th>
                    <th><?php echo $this->__('Scopes') ?></th>
                    <th><?php echo $this->__('Created') ?></th>
                    <th><?php echo $this->__('Secret Expires') ?></th>
                    <th><?php echo $this->__('Status') ?></th>
                    <th><?php echo $this->__('Actions') ?></th>
                </tr>
            </thead>
            <tbody>
            <?php foreach ($clients as $client): ?>
                <tr>
                    <td><?php echo $this->escapeHtml($client->getName()) ?></td>
                    <td><code><?php echo $this->escapeHtml($client->getClientId()) ?></code></td>
                    <td><?php echo $this->escapeHtml($client->getGrantTypes()) ?></td>
                    <td><?php echo $this->escapeHtml($client->getScopes()) ?></td>
                    <td><?php echo $this->escapeHtml($client->getCreatedAt()) ?></td>
                    <td>
                        <?php if ((int)$client->getStatus() === 1): ?>
                            <span style="color:green;"><?php echo $this->__('Active') ?></span>
                        <?php else: ?>
                            <span style="color:#999;"><?php echo $this->__('Disabled') ?></span>
                        <?php endif; ?>
                    </td>
                    <?php
                        // Render the Secret Expires cell with the same colour
                        // buckets as the admin Grid renderer (see
                        // Block/Adminhtml/Client/Grid/Renderer/SecretExpiry.php).
                        // Duplicated here intentionally because Mage_Core
                        // template inheritance is not worth the indirection
                        // for a single phtml that needs the same colour rules.
                        $xfeExpiresAt = $client->getClientSecretExpiresAt();
                        $xfeDaysLeft  = $this->helper('xfeoauth2')->getSecretDaysUntilExpiry($client);
                        if ($xfeExpiresAt === null || $xfeExpiresAt === '' || $xfeDaysLeft === null) {
                            $xfeExpiresHtml = '<span style="color:#999;">' . $this->escapeHtml($this->__('Unknown')) . '</span>';
                        } elseif ($xfeDaysLeft < 0) {
                            $xfeExpiresHtml = '<span style="color:#c0392b;font-weight:bold;">'
                                . $this->escapeHtml($this->__('Expired'))
                                . '</span><br><span style="color:#666;font-size:11px;">'
                                . $this->escapeHtml($xfeExpiresAt) . '</span>';
                        } elseif ($xfeDaysLeft <= 30) {
                            $xfeExpiresHtml = '<span style="color:#d68910;font-weight:bold;">'
                                . $this->escapeHtml($this->__('%d day(s) left', $xfeDaysLeft))
                                . '</span><br><span style="color:#666;font-size:11px;">'
                                . $this->escapeHtml($xfeExpiresAt) . '</span>';
                        } else {
                            $xfeExpiresHtml = '<span style="color:#1e8449;font-weight:bold;">'
                                . $this->escapeHtml($this->__('%d day(s) left', $xfeDaysLeft))
                                . '</span><br><span style="color:#666;font-size:11px;">'
                                . $this->escapeHtml($xfeExpiresAt) . '</span>';
                        }
                    ?>
                    <td><?php echo $xfeExpiresHtml ?></td>
                    <td>
                        <button type="button"
                                class="button"
                                onclick="revealClientSecret('<?php echo $this->escapeHtml($this->getRevealUrl($client->getClientId())) ?>', this)">
                            <?php echo $this->__('Show Secret') ?>
                        </button>
                        <?php
                            // Regenerate: a plain POST form (the controller
                            // does not require form_key because OAuth2 client
                            // management lives outside Magento's checkout /
                            // account-edit flow). The controller
                            // (XFE_OAuth2_ClientController::regenerateAction)
                            // redirects to */*/index?show_secret=... which
                            // re-uses the "save your secret now" box at the
                            // top of this template. No AJAX needed.
                            //
                            // URL helper lives in Block/Customer/OAuth2Client.php
                            // alongside getDeleteUrl / getRevealUrl for
                            // consistency with the rest of this template.
                        ?>
                        <form action="<?php echo $this->escapeHtml($this->getRegenerateUrl($client->getClientId())) ?>"
                              method="post"
                              onsubmit="return confirm('<?php echo $this->jsQuoteEscape($this->__('Regenerate the client secret? Existing tokens will stop working immediately.')) ?>');"
                              style="display:inline;margin-left:4px;">
                            <button type="submit"
                                    class="button"
                                    style="background:#f0ad4e;border-color:#eea236;color:#fff;">
                                <?php echo $this->__('Regenerate') ?>
                            </button>
                        </form>
                        <form action="<?php echo $this->getDeleteUrl($client->getClientId()) ?>"
                              method="post"
                              onsubmit="return confirm('<?php echo $this->jsQuoteEscape($this->__('Are you sure you want to delete this client? Existing tokens will stop working.')) ?>');"
                              style="display:inline">
                            <button type="submit" class="button">
                                <?php echo $this->__('Delete') ?>
                            </button>
                        </form>
                    </td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php else: ?>
        <p><?php echo $this->__('You have not created any API clients yet.') ?></p>
    <?php endif; ?>

    <p style="margin-top:20px;font-size:small;color:#666;">
        <?php echo $this->__('API clients allow external applications to access your account on your behalf via OAuth2 tokens. Use the client_credentials grant for server-to-server integrations.') ?>
    </p>
</div>

<div id="oauth2-reveal-box"
     style="display:none;border:2px solid #3c763d;background:#fcf8e3;padding:16px;margin-bottom:20px;">
    <h2 style="margin-top:0;color:#3c763d;"><?php echo $this->__('Client Secret') ?></h2>
    <p><strong><?php echo $this->__('Client ID') ?>:</strong>
        <code id="oauth2-reveal-client-id" style="user-select:all"></code></p>
    <p><strong><?php echo $this->__('Client Secret') ?>:</strong>
        <code id="oauth2-reveal-secret" style="user-select:all;word-break:break-all;"></code></p>
    <p><em><?php echo $this->__('Keep this secret safe. Anyone with it can access your data.') ?></em></p>
    <button type="button" class="button" onclick="document.getElementById('oauth2-reveal-box').style.display='none'">
        <?php echo $this->__('Close') ?>
    </button>
</div>

<script type="text/javascript">
//<![CDATA[
function revealClientSecret(url, btn) {
    if (!url) {
        return;
    }
    if (btn) {
        btn.disabled = true;
    }
    new Ajax.Request(url, {
        method: 'get',
        onSuccess: function (response) {
            if (btn) {
                btn.disabled = false;
            }
            try {
                var data = response.responseJSON;
            } catch (e) {
                data = null;
            }
            if (data && data.data && data.data.client_secret) {
                document.getElementById('oauth2-reveal-client-id').textContent = data.data.client_id || '';
                document.getElementById('oauth2-reveal-secret').textContent   = data.data.client_secret;
                document.getElementById('oauth2-reveal-box').style.display     = '';
                document.getElementById('oauth2-reveal-secret').scrollIntoView({behavior:'smooth', block:'center'});
            } else if (data && data.message) {
                alert(data.message);
            } else {
                alert('<?php echo $this->jsQuoteEscape($this->__('An error occurred while retrieving the secret.')) ?>');
            }
        },
        onFailure: function (response) {
            if (btn) {
                btn.disabled = false;
            }
            try {
                var data = response.responseJSON;
            } catch (e) {
                data = null;
            }
            alert(data && data.message ? data.message : '<?php echo $this->jsQuoteEscape($this->__('An error occurred while retrieving the secret.')) ?>');
        }
    });
}
//]]>
</script>

