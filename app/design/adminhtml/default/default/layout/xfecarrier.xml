<?xml version="1.0"?>
<layout>
    <!-- Carrier grid/list page -->
    <adminhtml_carrier_index>
        <reference name="content">
            <block type="xfe_carrier/adminhtml_carrier" name="carrier_grid" />
        </reference>
    </adminhtml_carrier_index>

    <!-- Carrier edit page: tabs on left, form in content -->
    <adminhtml_carrier_edit>
        <reference name="left">
            <block type="xfe_carrier/adminhtml_carrier_edit_tabs" name="carrier_tabs" />
        </reference>
        <reference name="content">
            <block type="xfe_carrier/adminhtml_carrier_edit" name="carrier_edit" />
        </reference>
    </adminhtml_carrier_edit>

    <!-- Bulk import landing page (1.0.13+). Form posts to importPost. -->
    <adminhtml_carrier_import>
        <reference name="content">
            <block type="xfe_carrier/adminhtml_carrier_import" name="carrier_import" template="xfe_carrier/carrier/import/container.phtml">
                <block type="xfe_carrier/adminhtml_carrier_import_form" name="carrier_import_form" as="form" />
            </block>
        </reference>
    </adminhtml_carrier_import>

    <!-- Result page (renders from registry, no form_key required). -->
    <adminhtml_carrier_importResult>
        <reference name="content">
            <block type="xfe_carrier/adminhtml_carrier_import_result" name="carrier_import_result" />
        </reference>
    </adminhtml_carrier_importResult>

    <!-- Add Logo page (standalone Magento form) -->
    <adminhtml_carrier_addlogo>
        <reference name="content">
            <block type="xfe_carrier/adminhtml_carrier_logo_edit" name="carrier_logo_edit" />
        </reference>
    </adminhtml_carrier_addlogo>

    <!-- Edit Logo page (same form block, loaded with a registered logo row) -->
    <adminhtml_carrier_editlogo>
        <reference name="content">
            <block type="xfe_carrier/adminhtml_carrier_logo_edit" name="carrier_logo_edit" />
        </reference>
    </adminhtml_carrier_editlogo>

    <!-- Account edit page -->
    <adminhtml_carrier_editaccount>
        <reference name="content">
            <block type="xfe_carrier/adminhtml_carrier_account_edit" name="carrier_account_edit" />
        </reference>
    </adminhtml_carrier_editaccount>

    <!-- FTP账号 edit page -->
    <adminhtml_carrier_editftpaccount>
        <reference name="content">
            <block type="xfe_carrier/adminhtml_carrier_ftpaccount_edit" name="carrier_ftpaccount_edit" />
        </reference>
    </adminhtml_carrier_editftpaccount>

    <!-- Rule edit page -->
    <adminhtml_carrier_editrule>
        <reference name="head">
            <action method="addJs">
                <file>mage/adminhtml/loader.js</file>
            </action>
            <action method="addItem">
                <type>skin_js</type>
                <name>xfe_shippingrule/js/condition-builder.js</name>
            </action>
        </reference>
        <reference name="content">
            <block type="xfe_carrier/adminhtml_carrier_rule_edit" name="carrier_rule_edit" />
        </reference>
    </adminhtml_carrier_editrule>

    <!-- Carrier grid (ajax) -->
    <adminhtml_carrier_grid>
        <reference name="content">
            <block type="xfe_carrier/adminhtml_carrier_grid" name="carrier_ajax_grid" />
        </reference>
    </adminhtml_carrier_grid>
</layout>
