<?php
/**
 * 自定义属性表单 field_type 联动 — 入口(ADR 0009)
 *
 * 真正的联动逻辑全部在:
 *   js/xfe_carrier/custom-attribute-form-switcher.js
 *   window.XfeCaTypeSwitcher
 *
 * 本模板只做四件事:
 *   1. 注入 window.XfeCaFormNotes(小改 A:type-specific note 文案)
 *   2. 等 DOM 就绪
 *   3. 取 field_type / options_csv / default_value 三个元素
 *   4. 调 XfeCaTypeSwitcher.bind(...) 启动联动
 *
 * 后端契约不变:default_value 字段 name 仍是 "default_value"。
 *
 * 关联文档:
 *   docs/architecture/xfe-carrier-custom-attribute-form-switcher-js.md
 *   docs/architecture/decisions/0009-js-extract-and-tests.md
 *   docs/architecture/decisions/0008-custom-attribute-form-ux.md
 *
 * @var XFE_Carrier_Block_Adminhtml_CustomAttribute_Edit_Form_TypeSwitcher $this
 */
?>
<script type="text/javascript">
//<![CDATA[
// 小改 A:注入 type-specific note 文案(JS bind() 内 switchType 读取)
window.XfeCaFormNotes = <?php echo json_encode(array(
    'default_value' => array(
        'text'        => Mage::helper('xfe_carrier')->__('任意字符串'),
        'number'      => Mage::helper('xfe_carrier')->__('数字(支持小数)'),
        'select'      => Mage::helper('xfe_carrier')->__('从上方"候选项"里选一个'),
        'multiselect' => Mage::helper('xfe_carrier')->__('从上方"候选项"里多选(按住 Ctrl/Shift)'),
        'boolean'     => Mage::helper('xfe_carrier')->__('选择 是 / 否'),
    ),
    'options_csv' => array(
        'select'      => Mage::helper('xfe_carrier')->__('必填,逗号分隔(如 红,绿,蓝)'),
        'multiselect' => Mage::helper('xfe_carrier')->__('可选,逗号分隔。留空 = 自由标签输入'),
    ),
)); ?>;

// 小改 D(2026-09-17):options_csv 变更时 JS 弹窗文案(配套 §2.10/§2.11)
window.XfeCaEditorLabels = <?php echo json_encode(array(
    'headTitle' => Mage::helper('xfe_carrier')->__('候选项(key / 显示名)'),
    'addBtn'    => Mage::helper('xfe_carrier')->__('+ 添加候选项'),
    'delBtn'    => Mage::helper('xfe_carrier')->__('删除'),
    'dupHint'   => Mage::helper('xfe_carrier')->__('key 重复'),
)); ?>;

window.XfeCaMigrationLabels = <?php echo json_encode(array(
    'confirm' => Mage::helper('xfe_carrier')->__(
        '修改候选项(options_csv)会导致现有默认值失效。\n'
        . '点 [确定] = 自动清洗(只保留合法项,丢弃非法)\n'
        . '点 [取消] = 恢复候选项(请重新编辑)'
    ),
)); ?>;
(function () {
    'use strict';

    function boot() {
        // 小改 M(2026-09-18):优先用 name 查找(兼容 Magento Form 给 input 加 id 前缀的场景,如 edit_form[options_csv])
        function findByName(name) {
            return document.querySelector('select[name="' + name + '"]')
                || document.querySelector('input[name="' + name + '"]')
                || document.querySelector('textarea[name="' + name + '"]')
                || document.getElementById(name);
        }
        var fieldTypeEl = findByName('field_type') || document.getElementById('field_type');
        var optionsEl   = findByName('options_csv') || document.getElementById('options_csv');
        var defaultEl   = findByName('default_value') || document.getElementById('default_value');
        if (!fieldTypeEl || !defaultEl) return;
        if (typeof window.XfeCaTypeSwitcher === 'undefined') return;

        XfeCaTypeSwitcher.bind({
            fieldTypeEl: fieldTypeEl,
            optionsEl:   optionsEl,
            defaultEl:   defaultEl,
            yesLabel:   '<?php echo Mage::helper("xfe_carrier")->__("是"); ?>',
            noLabel:    '<?php echo Mage::helper("xfe_carrier")->__("否"); ?>',
            blankLabel: '<?php echo Mage::helper("xfe_carrier")->__("-- 请选择 --"); ?>'
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
    } else {
        boot();
    }
}());
//]]>
</script>
<style type="text/css">
