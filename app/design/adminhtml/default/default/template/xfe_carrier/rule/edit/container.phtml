<?php
/**
 * XFE Carrier - Rule Edit Container Template
 *
 * Mirrors xfe_shippingrule/rule/edit/container.phtml so the Carrier
 * Rule Edit page renders with tabs (General Information + Conditions)
 * exactly like ShippingRule's edit page.
 *
 * Order:
 *   1. content-header (page title + buttons row: Back / Save)
 *   2. tabs block (renders the General + Conditions tabs)
 *   3. form (the outer <form>; tab content is moved into it by
 *      varienTabs JS)
 *   4. content-footer (Save button again, for sticky access)
 */
?>
<?php echo $this->getFormInitScripts() ?>
<div class="content-header">
    <?php echo $this->getHeaderHtml() ?>
    <p class="form-buttons"><?php echo $this->getButtonsHtml('header') ?></p>
</div>
<?php echo $this->getChildHtml('tabs') ?>
<?php echo $this->getFormHtml() ?>
<?php if ($this->hasFooterButtons()): ?>
    <div class="content-footer">
        <p class="form-buttons"><?php echo $this->getButtonsHtml('footer') ?></p>
    </div>
<?php endif; ?>
<script type="text/javascript">
    editForm = new varienForm('edit_form', '<?php echo $this->getValidationUrl() ?>');
</script>
<?php echo $this->getFormScripts() ?>