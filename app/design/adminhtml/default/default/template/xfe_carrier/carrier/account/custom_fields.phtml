<?php
/**
 * 自定义字段键值对编辑器(主账号 + FTP 账号共享)
 *
 * 模板数据:
 *   $rawJson     string|null  该账号已存的 custom_fields_json 原文
 *   $entityType  string       'account' | 'ftp_account'(用于 JS 提交时区分)
 *
 * POST 形态(由 JS 在提交时构造,Form.serialize() 抓得到):
 *   custom_fields[<key>][label]   = string
 *   custom_fields[<key>][type]    = text|number|select|boolean
 *   custom_fields[<key>][value]   = mixed
 *   custom_fields[<key>][options] = string (逗号分隔,仅 type=select)
 *
 * 删除某行 = 不提交该 key;后端 Service::applyFromPost() 会自动 diff 出来。
 *
 * 关联文档: docs/architecture/carrier-account-custom-fields.md
 */
/** @var string|null $rawJson */
/** @var string $entityType */
$helper = Mage::helper('xfe_carrier');
$bag    = array();
if (is_string($rawJson) && $rawJson !== '') {
    $decoded = json_decode($rawJson, true);
    if (is_array($decoded)) {
        foreach ($decoded as $k => $v) {
            if (is_string($k) && is_array($v)) {
                $bag[$k] = $v;
            }
        }
    }
}
$fieldId = 'xfe-carrier-custom-fields-editor-' . md5($entityType . '|' . spl_object_hash($this));
$bagJson = Mage::helper('core')->jsonEncode($bag ?: new stdClass());
?>
<style>
.xfe-cf-editor { width:100%; border-collapse:collapse; }
.xfe-cf-editor th, .xfe-cf-editor td {
    padding:6px 8px; border-bottom:1px solid #ddd; vertical-align:middle;
}
.xfe-cf-editor th { background:#f6f6f6; text-align:left; font-weight:600; }
.xfe-cf-editor input[type=text], .xfe-cf-editor select { width:100%; box-sizing:border-box; }
.xfe-cf-editor .col-handle { width:32px; text-align:center; cursor:move; color:#999; }
.xfe-cf-editor .col-act    { width:60px; text-align:center; }
.xfe-cf-editor .col-key    { width:18%; }
.xfe-cf-editor .col-label  { width:18%; }
.xfe-cf-editor .col-type   { width:14%; }
.xfe-cf-editor .col-value  { width:30%; }
.xfe-cf-editor .col-options{ width:20%; }
.xfe-cf-row-removed td { opacity:0.45; }
.xfe-cf-row-removed .xfe-cf-row-input { text-decoration:line-through; }
.xfe-cf-toolbar { margin-top:8px; }
.xfe-cf-empty { color:#999; font-style:italic; padding:8px 0; }

/* multiselect chip input */
.xfe-cf-chips {
    display:flex; flex-wrap:wrap; gap:4px; align-items:center;
    min-height:28px; padding:3px; border:1px solid #ccc; border-radius:3px;
    background:#fff; cursor:text;
}
.xfe-cf-chips:focus-within { border-color:#5b9dd9; box-shadow:0 0 2px #5b9dd9; }
.xfe-cf-chip {
    display:inline-flex; align-items:center; gap:4px;
    background:#e1f0ff; border:1px solid #b0d4f1; border-radius:3px;
    padding:1px 4px 1px 8px; font-size:12px; line-height:18px;
}
.xfe-cf-chip-x { cursor:pointer; color:#999; font-weight:bold; padding:0 2px; }
.xfe-cf-chip-x:hover { color:#c00; }
