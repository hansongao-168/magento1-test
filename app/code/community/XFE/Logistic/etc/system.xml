<?xml version="1.0"?>
<config>
    <tabs>
        <xfe translate="title">
            <label>XFE</label>
            <sort_order>250</sort_order>
        </xfe>
    </tabs>
    <sections>
        <xfe_logistic translate="label" module="xfe_logistic">
            <label>Logistic (GLS)</label>
            <tab>xfe</tab>
            <frontend_type>text</frontend_type>
            <sort_order>110</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>0</show_in_website>
            <show_in_store>0</show_in_store>
            <groups>
                <gls_api translate="label">
                    <label>GLS Web API</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <base_url translate="label comment">
                            <label>Base URL</label>
                            <comment>GLS Web API 基础地址。测试: https://shipit-wbm-test01.gls-group.eu:443/backend/rs/tracking。生产地址在 GLS label validation 阶段后由 GLS 提供。</comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </base_url>
                        <username translate="label comment">
                            <label>Username</label>
                            <comment>GLS Web API 登录用户名（Basic Auth）。</comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </username>
                        <password translate="label comment">
                            <label>Password</label>
                            <comment>GLS Web API 登录密码（Basic Auth）。保存后自动加密。</comment>
                            <frontend_type>obscure</frontend_type>
                            <backend_model>adminhtml/system_config_backend_encrypted</backend_model>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </password>
                        <parcelpod_resource translate="label comment">
                            <label>Parcel POD Resource</label>
                            <comment>Collect POD 资源名（默认: parcelpod）。</comment>
                            <frontend_type>text</frontend_type>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </parcelpod_resource>
                    </fields>
                </gls_api>
            </groups>
        </xfe_logistic>
    </sections>
</config>
