<?xml version="1.0" encoding="UTF-8"?>
<config>
    <modules>
        <XFE_Carrier>
            <version>1.0.15</version>
        </XFE_Carrier>
    </modules>
    <global>
        <models>
            <xfe_carrier>
                <class>XFE_Carrier_Model</class>
                <resourceModel>xfe_carrier_resource</resourceModel>
                <!--
                    The entity alias 'carrier_ftp_account' would, after uc_words(),
                    become 'XFE_Carrier_Model_Carrier_Ftp_Account' - which does NOT
                    match our real class name XFE_Carrier_Model_Carrier_FtpAccount.
                    The <rewrite> element forces Magento's factory to use the real
                    class name. Mirror of Mage's factory mechanism in
                    Mage_Core_Model_Config::getGroupedClassName().
                -->
                <rewrite>
                    <carrier_ftp_account>XFE_Carrier_Model_Carrier_FtpAccount</carrier_ftp_account>
                </rewrite>
            </xfe_carrier>
            <xfe_carrier_resource>
                <class>XFE_Carrier_Model_Resource</class>
                <entities>
                    <carrier>
                        <table>xfe_carrier</table>
                    </carrier>
                    <carrier_logo>
                        <table>xfe_carrier_logo</table>
                    </carrier_logo>
                    <carrier_account>
                        <table>xfe_carrier_account</table>
                    </carrier_account>
                    <carrier_ftp_account>
                        <table>xfe_carrier_ftp_account</table>
                    </carrier_ftp_account>
                    <carrier_rule>
                        <table>xfe_carrier_rule</table>
                    </carrier_rule>
                    <rule_condition_group>
                        <table>xfe_carrier_rule_condition_group</table>
                    </rule_condition_group>
                    <rule_condition>
                        <table>xfe_carrier_rule_condition</table>
                    </rule_condition>
                    <carrier_translation>
                        <table>xfe_carrier_translation</table>
                    </carrier_translation>
                    <custom_attribute>
                        <table>xfe_carrier_custom_attribute</table>
                    </custom_attribute>
                </entities>
                <!--
                    Same uc_words reason as the model rewrite above:
                    alias 'carrier_ftp_account' must resolve to the real
                    class names without an injected underscore between
                    'Ftp' and 'Account'. The resource collection has its
                    own entry because its suffix is appended after the
                    alias.
                -->
                <rewrite>
                    <carrier_ftp_account>XFE_Carrier_Model_Resource_Carrier_FtpAccount</carrier_ftp_account>
                    <carrier_ftp_account_collection>XFE_Carrier_Model_Resource_Carrier_FtpAccount_Collection</carrier_ftp_account_collection>
                </rewrite>
            </xfe_carrier_resource>
        </models>
        <blocks>
            <xfe_carrier>
                <class>XFE_Carrier_Block</class>
                <!--
                    Block aliases whose names contain two underscore-separated
                    CamelCase words (e.g. ftp_account) get an underscore
                    injected by Mage_Core_Model_Config::getGroupedClassName()'s
                    uc_words(), breaking the lookup. Rewrite them to the real
                    class names. Mirrors the model/resource rewrites above.

                    Only the form-block alias is actually used today -
                    Mage_Adminhtml_Block_Widget_Form_Container::_prepareLayout()
                    constructs it from $_blockGroup.'/'.$_controller.'_'.$_mode.'_form'.
                    Single-segment aliases (e.g. adminhtml_carrier_edit_tab_ftpaccount
                    / _grid / _rules_grid) work without rewrite.
                -->
                <rewrite>
                    <adminhtml_carrier_ftp_account_edit_form>XFE_Carrier_Block_Adminhtml_Carrier_FtpAccount_Edit_Form</adminhtml_carrier_ftp_account_edit_form>
                </rewrite>
            </xfe_carrier>
        </blocks>
        <helpers>
            <xfe_carrier>
                <class>XFE_Carrier_Helper</class>
            </xfe_carrier>
        </helpers>
        <resources>
            <xfe_carrier_setup>
                <setup>
                    <module>XFE_Carrier</module>
                    <class>Mage_Core_Model_Resource_Setup</class>
                </setup>
            </xfe_carrier_setup>
        </resources>
    </global>
    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <xfe_carrier after="Mage_Adminhtml">XFE_Carrier_Adminhtml</xfe_carrier>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>
    <adminhtml>
        <menu>
            <system>
                <children>
                    <xfe_carrier translate="title" module="xfe_carrier">
                        <title>承运商管理</title>
                        <sort_order>130</sort_order>
                        <action>adminhtml/carrier/index</action>
                        <children>
                            <custom_attribute translate="title" module="xfe_carrier">
                                <title>自定义属性</title>
                                <sort_order>50</sort_order>
                                <action>adminhtml/carrier_customAttribute/index</action>
                            </custom_attribute>
                        </children>
                    </xfe_carrier>
                </children>
            </system>
        </menu>
        <acl>
            <resources>
                <admin>
                    <children>
                        <system>
                            <children>
                                <xfe_carrier translate="title" module="xfe_carrier">
                                    <title>承运商管理</title>
                                </xfe_carrier>
                            </children>
                        </system>
                    </children>
                </admin>
            </resources>
        </acl>
        <layout>
            <updates>
                <xfecarrier>
                    <file>xfecarrier.xml</file>
                </xfecarrier>
            </updates>
        </layout>
    </adminhtml>
</config>




