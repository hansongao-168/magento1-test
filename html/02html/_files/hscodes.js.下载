hscodesInput = Class.create();
hscodesInput.prototype = {
    initialize: function (inputElm, targetElm, isfilp)
    {
        this.inputElm = $(inputElm);
        this.inputDivId = inputElm + ':div';
        this.inputDivElm = null;
        this.targetElm = $(targetElm);
        this.hscodes = hscodes;
        this.hscodesArr = hscodesArr;
        this.data = [];
        this.maxListCount = 20;
        this.div = null;
        this.ul = null;
        this._tid = 0;
        this._onSelected = [];
        this.isfilp = isfilp;

        this.createDiv();

        var self = this;

        var _onInput = function () {
            self.showList(this.value);
        };

        var _onBlur = function () {
            if (self._tid !== false) {
                self._tid = window.setTimeout(function () {
                    self.showList(false);
                    self._tid = 0;
                }, 20);
            } else {
                self._tid = 0;
            }
        };

        this.inputElm.observe('input', _onInput);
        this.inputElm.observe('focus', _onInput);
        this.inputElm.observe('blur', _onBlur);
        this.inputElm.writeAttribute('autocomplete', 'new-password');
        this.inputElm.writeAttribute('data-button', 'hscode');

        this.onSelected(function (data) {
            if (typeof data[0] !== "undefined") self.targetElm.value = self.isfilp ? data[1] : data[0];
        });

        this.inputElm.parentNode.observe("mouseover", function () {
            if (self.inputDivElm.hasClassName("no-display")) {
                self.inputDivElm.removeClassName("no-display");
            }
        });
        this.inputElm.parentNode.observe("mouseout", function () {
            if (!self.inputDivElm.hasClassName("no-display")) {
                self.inputDivElm.addClassName("no-display");
            }
        });
    },

    showList: function(value)
    {
        this.data = [];
        var self = this;
        if (value || value === '0') {
            var v;
            for (item of this.hscodes) {
                if (self.isfilp) {
                    v = item[0];
                } else {
                    v = item[1];
                    if (v) {
                        v = v.replace(/(à|â)/g,"a")
                            .replace(/(è|é|ê|ë)/g,"e")
                            .replace(/(î|ï)/g,"i")
                            .replace(/(ô|ö)/g,"o")
                            .replace(/(ù|û|ü)/g,"u")
                            .replace(/(ç)/g,"c")
                            .replace(/(œ)/g,"ce")
                            .replace(/(æ)/g,"ae")
                            .replace(/(À|Â)/g,"A")
                            .replace(/(È|É|Ê|Ë)/g,"E")
                            .replace(/(Î|Ï)/g,"I")
                            .replace(/(Ô|Ö)/g,"O")
                            .replace(/(Ù|Û)/g,"U")
                            .replace(/(Ç)/g,"C")
                            .replace(/(Œ)/g,"CE")
                            .replace(/(Æ)/g,"AE");
                    }
                    value = value.replace(/(à|â)/g,"a")
                        .replace(/(è|é|ê|ë)/g,"e")
                        .replace(/(î|ï)/g,"i")
                        .replace(/(ô|ö)/g,"o")
                        .replace(/(ù|û|ü)/g,"u")
                        .replace(/(ç)/g,"c")
                        .replace(/(œ)/g,"ce")
                        .replace(/(æ)/g,"ae")
                        .replace(/(À|Â)/g,"A")
                        .replace(/(È|É|Ê|Ë)/g,"E")
                        .replace(/(Î|Ï)/g,"I")
                        .replace(/(Ô|Ö)/g,"O")
                        .replace(/(Ù|Û)/g,"U")
                        .replace(/(Ç)/g,"C")
                        .replace(/(Œ)/g,"CE")
                        .replace(/(Æ)/g,"AE");
                }

                if (item[0] && item[1] && v.toUpperCase().indexOf(value.toUpperCase()) === 0) {
                    this.data.push([item[0], item[1], 1]);
                    for (itemArr of this.hscodesArr) {
                        if (item[0] == itemArr[0] && itemArr[1].length == 8) {
                            this.data.push([itemArr[1], itemArr[2]]);
                        }
                    }
                }
                if (this.data.length >= this.maxListCount) break;
            }

            if (this.data.length > 0) {
                this.getUl().useData = this.data;
                this.getUl().innerHTML = this._createList(this.data);
                $(this.getUl()).show();
                this._setOffset();
                this._addEvent();
            } else if (this.ul) {
                this.ul.innerHTML = "";
                $(this.ul).hide();
            }
        }
        return this;
    },

    createDiv: function () {
        if (document.getElementById(this.inputDivId)) {
            var inputElementDiv = document.getElementById(this.inputDivId);
        } else {
            var inputElementDiv = document.createElement("div");
            $(inputElementDiv).id = this.inputDivId;
            this.inputElm.after($(inputElementDiv));
        }
        $(this.inputDivId).className = "no-display";
        this.inputDivElm = $(inputElementDiv);
    },

    _createList: function ()
    {
        var i = 0, j = 0, len = this.data.length, html = '', h;
        for (; i < len; i++) {
            if (this.data[i].length == 3) {
                html += '<li data-label="1" class="item">';
            } else {
                html += '<li class="item" data-index="' + i + '" style="padding-left: 5px;">';
            }
            for (j = 0; j < 2; j++) {
                h = j == 0 ? '<strong>' + this.data[i][j] + '</strong>' : this.data[i][j];
                html += '<div class="content">' + h + '</div>';
            }
            html += '</li>';
        }
        return html;
    },

    _setOffset: function () {
        var a = this.inputElm.positionedOffset(), b = this.inputElm.getDimensions();
        $(this.getUl()).setStyle({
            "top": (b.height + a.top) + "px",
            "left": b.left + "px"
        });
        return this;
    },

    _addEvent: function () {
        var self = this;
        $(this.getUl()).select("li").each(function (li) {
            $(li).observe("click", function () {
                if (this.getAttribute("data-label")) {
                    return false;
                }
                var i = this.getAttribute("data-index");
                self._triggerEvent(self.getUl().useData[i]);
                self.showList(false);
                if (self._tid) {
                    window.clearTimeout(self._tid);
                    self._tid = 0;
                }
            });
            $(li).observe("mousedown", function () {
                if (self._tid) {
                    window.clearTimeout(self._tid);
                    self._tid = 0;
                } else self._tid = false;
            });
        });
        return this;
    },

    _triggerEvent: function (data) {
        for (var i = 0, len = this._onSelected.length; i < len; i++) {
            this._onSelected[i](data, this);
        }
        return this;
    },

    onSelected: function (fun) {
        if (typeof fun === "function") {
            this._onSelected.push(fun);
        }
        return this;
    },

    getUl: function () {
        if (!this.ul) {
            this.ul = document.createElement("ul");
            $(this.ul).addClassName('hscodesList');
            this.inputDivElm.append(this.getUl());
        }
        return this.ul;
    },

    setMaxListCount: function (count) {
        this.maxListCount = parseInt(count);
        if (isNaN(this.maxListCount) || this.maxListCount < 1) {
            this.maxListCount = 1;
        }
        return this;
