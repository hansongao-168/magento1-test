//define postcode validate method
function postCodeValidate(type,selectedValue){
    var $ = jQuery;
    var placeholderTxt = "";
    var validateCountryArray = ['FR','BE','PT','NL','CH','IT','CN','GB','NB','SF','EN','WL','DK','JP'];

    if($("#fromaddress-country select").length > 0){
        type = "billing";
    }else if($("#toaddressee-country select").length > 0){
        type = "shipping";
    }
    var cSelectedVal  = $("select[id='country'] option:selected").val();
    var cAselectedVal = $("select[id='"+type+"\\:country_id'] option:selected").val();
    var postCodeEle = type ? $("input[id='"+type+"\\:postcode']") : $("input[name='postcode']");
    var styleCode = false;

    selectedValue = selectedValue ? selectedValue  : type ? cAselectedVal : cSelectedVal;
    postCodeEle.attr("placeholder",Translator.translate("Please fill in the correct zip code"));
    postCodeEle.removeClass("validate-seven-num validate-six-num validate-six-num-cn validate-five-num validate-four-num validate-postcode-gb validate-postcode-nl validation-failed validate-alphanum-with-spaces");

    postCodeEle.removeClass("validate-seven-jp");
    if (postCodeEle.attr("data-orig-classname") == "validate-alphanum") {
        postCodeEle.addClass("validate-alphanum")
        postCodeEle.removeAttr("data-orig-classname");
    }

    if($.inArray(selectedValue,validateCountryArray) >= 0){
        if($.inArray(selectedValue,['PT']) >= 0){
            styleCode = "validate-seven-num";
            placeholderTxt = Translator.translate("Please enter the 7 digit zip code");
        }else if($.inArray(selectedValue,['CN']) >= 0){
            styleCode = "validate-six-num-cn";
            placeholderTxt = Translator.translate("Please enter the 6 digit zip code");
        }else if($.inArray(selectedValue,['FR','IT']) >= 0){
            styleCode = "validate-five-num";
            placeholderTxt = Translator.translate("Please enter the 5 digit zip code");
        }else if($.inArray(selectedValue,['BE','CH','DK']) >= 0){
            styleCode = "validate-four-num";
            placeholderTxt = Translator.translate("Please enter the 4 digit zip code");
        }else if($.inArray(selectedValue,['GB','NB','SF','EN','WL']) >= 0){
            styleCode = "validate-postcode-"+selectedValue.toLowerCase();
            placeholderTxt = Translator.translate("Please fill in the correct UK zip code");
        }else if($.inArray(selectedValue,['NL']) >= 0){
            styleCode = "validate-postcode-"+selectedValue.toLowerCase();
            placeholderTxt = Translator.translate("Please fill in the correct Dutch postal code");
        }else if($.inArray(selectedValue,['JP']) >= 0){
            styleCode = "validate-seven-jp";
            placeholderTxt = Translator.translate("Please enter a zip code in this field in the format 000-0000 without spaces or other characters");
            if (postCodeEle.hasClass("validate-alphanum")) {
                postCodeEle.attr("data-orig-classname", "validate-alphanum");
            }
            postCodeEle.removeClass("validate-alphanum");
        }

        postCodeEle.attr("placeholder",placeholderTxt);
        if(styleCode)postCodeEle.addClass(styleCode);

        if($.inArray(selectedValue,['GB','NB','SF','EN','WL','NL']) >= 0){
            postCodeEle.addClass("validate-alphanum-with-spaces");
        }
    }
}
