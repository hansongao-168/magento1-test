//search keywords
function filterContent(filter,container,keyTag,keyContainer,resultTag,noChildTag){
    var filterDom =jQuery(filter);
    var containerDom =jQuery(container);

    keyContainer = (typeof keyContainer !== 'undefined') ?  keyContainer : containerDom.find(jQuery(keyTag)).parent().prop("tagName");
    resultTag = (typeof resultTag !== 'undefined') ? resultTag : "b";
    noChildTag = (typeof noChildTag !== 'undefined') ? noChildTag : "p";
    if(filterDom && containerDom){
        filterDom.bind("input propertychange",function(){
            var value = jQuery(this).val().trim();
            containerDom.find(jQuery(keyTag)).parents(keyContainer).attr("filterFlag","false");
            containerDom.find(jQuery(keyTag)).each(function(i,o){
                if(jQuery(o).children().length<=0){
                    jQuery(o).html("<"+noChildTag+">"+jQuery(o).text()+"</"+noChildTag+">");
                }
                jQuery(o).children().each(function(j,obj){
                    var contentText = jQuery(obj).text();
                    if(contentText.toUpperCase().indexOf(value.toUpperCase())>=0 && value!=''){
                        contentText = contentText.replace(new RegExp('('+value+')',"gi"),"<"+resultTag+">"+"$1"+"</"+resultTag+">");
                        jQuery(obj).parents(keyContainer).attr("filterFlag","true");
                    }
                    jQuery(obj).html(contentText);
                });
                if(value =='' || jQuery(o).parents(keyContainer).attr("filterFlag") == "true"){
                    jQuery(o).parents(keyContainer).show();
                }else{
                    jQuery(o).parents(keyContainer).hide();
                }
            });
        });
    }
}

/**
 * 弹出提示
 * 提示样式可选“success-msg/error-msg” msgclass
 * 消息内容 msg
 * 描述 label
 */
function showMessages(msgclass, msg, label) {
    var messages = jQuery('<ul class="messages custom-messages">'),
        msgHtml = "", msgTitle;
    var closeMsg = function() {
        messages.remove();
        JSExt.documentBody.enable();
    };
    switch (msgclass) {
        case 'success-msg':
            msgTitle = null;
            break;
        case 'error-msg':
            msgTitle = 'ERREUR';
            break;
        case 'notice-msg':
            msgTitle = 'ATTENTION';
            break;
        default:
            msgTitle = null;
    }
    msgHtml +=    `<li class="${msgclass}">
                        <ul class="msg-icon-container">
                            <li><i class="msg-icon"></i></li>
                        </ul>
                        <ul class="msg-content-container">`;
    msgHtml += `${ msgTitle ? `<li class="msg-title">${msgTitle}</li>` : '' }`;
    msgHtml +=      `${ msg ? `<li><span>${msg}</span></li>` : '' }`;
    msgHtml +=    `${ label ? `<li><label class="label">${label}</label></li>` : '' }`;
    msgHtml +=          `</ul>
                    </li>
                    <li class="message-close-container">
                        <button type="button" class="message-close ${msgclass}-btn" id="message-close">OK</button>
                    </li>`;
    messages.html(msgHtml);
    jQuery("body").append(messages);
    jQuery(".message-close").bind("click", closeMsg);
    messages.addClass("show");
    JSExt.documentBody.disable(closeMsg);
    JSExt.documentBody.center(messages);
}
