function favorite(favUrl, notLoginUrl, elem, cartData=false){
    window.event.stopPropagation()
    var options = ''
    if(cartData) options = cartData.getSelectedOptions(jQuery(elem).attr('data-entity-id'));
    jQuery.ajax({
        type : "post",
        url : favUrl,
        dataType : "json",
        data : {
            id : jQuery(elem).attr('data-id'),
            entity_id : jQuery(elem).attr('data-entity-id'),
            event : jQuery(elem).attr('data-event'),
            selected_options : options
        },
        success : function (res) {
            if (res.success) {
                showMessages('success-msg', res.message);
                var span = jQuery(elem).children('span');
                if (1 === res.code) {
                    jQuery(elem).addClass('active');
                    jQuery(elem).attr('title',jQuery(elem).attr('data-t'));
                    jQuery(elem).attr('data-event','cancel');
                    if (res.id) {
                        jQuery(elem).attr('data-id',res.id);
                    }
                    if (span.length) {
                        span.html('<i></i>'+jQuery(elem).attr('data-t'));
                    }
                } else if (2 === res.code) {
                    jQuery(elem).removeClass('active');
                    jQuery(elem).attr('title',jQuery(elem).attr('data-f'));
                    jQuery(elem).attr('data-event','add');
                    jQuery(elem).attr('data-id','');
                    if (span.length) {
                        span.html('<i></i>'+jQuery(elem).attr('data-f'));
                    }
                }
                if (jQuery(elem).attr('data-reload')) {
                    setTimeout(function () {
                        window.location.reload();
                    }, 1000);
                }
            } else {
                showMessages('notice-msg', res.message);
                if (3 === res.code) {
                    setTimeout(function () {
                        window.location.href = notLoginUrl;
                    }, 1000);
                }
            }
        }
    });
}

