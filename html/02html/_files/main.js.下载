function changeQty(elm,operateType){
    var inp;
    var _add = function(inp){
        if(!inp.disabled){
            var v = inp.value.replace(/^\s+|\s+$/g,""),max = inp.getAttribute("max-number"),step = JSExt.toFloat(inp.getAttribute("step-number")) || 1;
            if(max!==null && isNaN(max = parseInt(max)))max = null;
            if(v===""){v = step;}
            else{v = isNaN(v = parseInt(v)) ? step : v+step;}
            if(max!==null && v>max)v = max;
            if(inp.value!=v){
                inp.value = v;
                JSExt.Event.fire(inp,'change');
                JSExt.Event.fire(inp,'keyup');
            }
        }
        return inp;
    };
    var _sub = function(inp){
        if(!inp.disabled){
            var v = inp.value.replace(/^\s+|\s+$/g,""),min = inp.getAttribute("min-number"),step = JSExt.toFloat(inp.getAttribute("step-number")) || 1;
            if(min!==null && isNaN(min = parseInt(min)))min = null;
            if(min===null && inp.className && inp.className.indexOf('livraisonQty')>-1)min = 0;
            if(v!==""){
                if(isNaN(v = parseInt(v))){
                    v = min===null ? "" : min;
                }else{
                    v -= step;
                    if(min!==null && v<min)v = min;
                    else if(min===null && v<=0)v = "";
                }
            }else{
                v = min===null ? "" : min;
            }
            if(v!=inp.value){
                inp.value = v;
                JSExt.Event.fire(inp,'change');
                JSExt.Event.fire(inp,'keyup');
            }
        }
        return inp;
    };
    switch(operateType){
        case "sub":
            if(inp = $(elm).next('input[type="text"]'))_sub(inp);
            break;
        case "add":
            if(inp = $(elm).previous('input[type="text"]'))_add(inp);
            break;
    }
}

