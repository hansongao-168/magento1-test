function showMagentoHtmlMessages(){
    var messages = jQuery('ul.messages');
    if(!!messages.length){
        for(var i = 0; i < messages.length; i++) {
            var msgItem = jQuery(messages[i]);
            if(!msgItem.hasClass('custom-messages')) {
                var msgOutter = msgItem.find('li').eq(0);
                var msgContent = msgItem.find('ul').eq(0);
                var msgClass = msgOutter.attr('class'), msgTitle = null;
                var msgTypeArr = [
                    {
                        'type': 'success-msg',
                        'title': null
                    },
                    {
                        'type': 'error-msg',
                        'title': 'ERREUR'
                    },
                    {
                        'type': 'notice-msg',
                        'title': 'ATTENTION'
                    }
                ]
                for(var index = 0; index < msgTypeArr.length; index++) {
                    var item = msgTypeArr[index];
                    if(item.type.indexOf(msgClass) >=0) {
                        msgTitle = item.title;
                        break;
                    }
                }
                var msgIconHtml = `<ul class="msg-icon-container">
                                        <li><i class="msg-icon"></i></li>
                                    </ul>`;
                var msgCloseBtnHtml = `<li class="message-close-container">
                                        <button type="button" class="message-close ${msgClass}-btn">OK</button>
                                       </li>`;
                var closeMsg = function() {
                    msgItem.remove();
                    JSExt.documentBody.enable();
                };
                msgTitle ? msgContent.prepend(`<li class="msg-title">${msgTitle}</li>`) : '';
                msgContent.before(msgIconHtml).addClass('msg-content-container');
                jQuery(messages[i]).addClass('custom-messages show');
                if (!jQuery('.message-close-container').hasClass('zy-button')) jQuery(messages[i]).append(msgCloseBtnHtml);
                msgItem.find(".message-close").bind("click", closeMsg);
                JSExt.documentBody.disable(closeMsg);
                JSExt.documentBody.center(msgItem);
            }
        }
    }
    return messages;
}
