var JSExt = {
    isEmpty:function(v){
        var emp = v===undefined || v===null || v===false || v==="";
        if(!emp && typeof(v)==="object"){
            var t = Object.prototype.toString.call(v);
            if(t=="[object Array]"){
                emp = v.length==0;
            }else if(t=="[object Object]"){
                emp = Object.keys(t).length==0;
            }
        }
        return emp;
    },
    toString:function(v){
        if(JSExt.isEmpty(v))return "";
        if(v===true)return "1";
        return v.toString();
    },
    toInt:function(v){
        if(JSExt.isEmpty(v))return 0;
        if(v===true)return 1;
        v = parseInt(v);
        return isNaN(v) ? 0 : v;
    },
    toFloat:function(v){
        if(JSExt.isEmpty(v))return 0;
        if(v===true)return 1;
        v = parseFloat(v);
        return isNaN(v) ? 0 : v;
    },
    toBool:function(v){
        if(v===true || v===false)return v;
        if(JSExt.isEmpty(v) || v==='0')return false;
        if(typeof v === 'string'){
            v = v.toLowerCase(v);
            if(v==='true' || v==='yes')return true;
            if(v==='false' || v==='no' || v==='null' || v==='undefined')return false;
        }
        return !!v;
    },
    round:function(num,precision,toString){
        if(isNaN(num))return 0;
        if(!precision || isNaN(precision = parseInt(precision)))precision = 0;
        var p = 1;
        for(var i = 0; i < precision; i++)p *= 10;
        var $num = p == 1 ? Math.round(num) : Math.round(num * p) / p;
        if(toString && precision>0){
            $num += 1 / p / 10;
            $num = $num.toString();
            $num = $num.substr(0,$num.indexOf(".") + precision + 1);
        }
        return $num;
    },
    getElementValue:function(elm,o){
        if(!elm)return null;
        if(elm.tagName){
            if(!o)return $F(elm);
            if(elm.type=="radio")return elm.checked ? elm : "";
            if(elm.type=="checkbox")return elm.checked ? [elm] : [];
            return elm;
        }
        var len = elm.length;
        if(!len)return null;
        var isRadio = elm[0].type=="radio",v = [];
        for(var i = 0;i<len;i++){
            if(elm[i].checked){
                if(isRadio)return o ? elm[i] : elm[i].value;
                v.push(o ? elm[i] : elm[i].value);
            }
        }
        return isRadio ? "" : v;
    }
};

JSExt.Event = {
    bind: function(oTarget, sEventType, fnHandler) {
        if(oTarget.addEventListener){
            oTarget.addEventListener(sEventType, fnHandler, false);
        }else if(oTarget.attachEvent){
            oTarget.attachEvent("on" + sEventType, fnHandler);
        }else{
            oTarget["on" + sEventType] = fnHandler;
        }
    },
    unbind: function(oTarget, sEventType, fnHandler) {
        if(oTarget.removeEventListener){
            oTarget.removeEventListener(sEventType, fnHandler, false);
        }else if(oTarget.detachEvent){
            oTarget.detachEvent("on" + sEventType, fnHandler);
        }else{
            oTarget["on" + sEventType] = null;
        }
    },
    getEvent: function() {
        if(window.event){
            return window.event;
        }else{
            return JSExt.Event.getEvent.caller.arguments[0];
        }
    },
    getSrcElement: function(evt) {
        return evt.srcElement ? evt.srcElement : evt.target;
    },
    fire: function(element, eventName) {
        if (element) {
            if (document.all && navigator.userAgent.toLowerCase().match(/msie ([\d.]+)/)[1] < 9) {
                element.fireEvent('on' + eventName);
            } else {
                var evt = document.createEvent('HTMLEvents');
                evt.initEvent(eventName, true, true);
                element.dispatchEvent(evt);
            }
        }
    }
};
JSExt.Event.Customize = {
    eventListener:{},
    addEventListener:function(name,fun){
        if(typeof(name)=='string' && typeof(fun)=='function'){
            if(typeof JSExt.Event.Customize.eventListener[name] != 'object')JSExt.Event.Customize.eventListener[name] = [];
            JSExt.Event.Customize.eventListener[name].push(fun);
        }
        return JSExt.Event;
    },
    triggerEvent:function(name){
        if(typeof JSExt.Event.Customize.eventListener[name] == 'object'){
            var argc = arguments.length,params = [];
            for(var j = 1;j<argc;j++)params.push(arguments[j]);
            params.push(JSExt.Event);
            for(var i = 0,len = JSExt.Event.Customize.eventListener[name].length;i<len;i++){
                JSExt.Event.Customize.eventListener[name][i].apply(JSExt.Event.Customize, params);
            }
        }
        return JSExt.Event;
    },
    removeEventListener:function(name,fun){
        if(typeof JSExt.Event.Customize.eventListener[name] == 'object'){
            var eventListener = [],removeCount = 0,len = JSExt.Event.Customize.eventListener[name].length,i;
            for(i = 0;i<len;i++){
                if(JSExt.Event.Customize.eventListener[name][i]==fun){
                    removeCount++;
                }else{
                    eventListener.push(JSExt.Event.Customize.eventListener[name][i]);
                }
            }
            if(removeCount>0)JSExt.Event.Customize.eventListener[name] = eventListener;
        }
        return JSExt.Event;
    }
};
JSExt.documentBody = {
    disable:function(clickCallback,element){
        var a = document.getElementById('disable-page-mask-div');
        var _set = function(a,b){
            var offset = jQuery(b).offset(),w = jQuery(b).width(),h = jQuery(b).height();
            return jQuery(a).css({top:offset.top+'px',left:offset.left+'px',width:w+'px',height:h+'px'});
        };
        if(!a){
            a = document.createElement('div');
            a.setAttribute('id','disable-page-mask-div');
            a.style.zIndex = 9;
            a.style.backgroundColor = 'rgba(234,234,234,0.5)';
            document.body.appendChild(a);
        }else{
            a.style.display = 'block';
        }
        if(element){
            a.style.position = 'absolute';
            _set(a,element);
        }else{
            jQuery(a).css({position:'fixed',top:'0px',left:'0px',width:'100%',height:'100%'});
        }
        if(typeof clickCallback=='function'){
            a.onclick = function(){clickCallback(this);};
        }else{
            a.onclick = clickCallback ? JSExt.documentBody.enable : function(){};
        }
        JSExt.Event.Customize.triggerEvent("document_body_disable_after",a);
        return a;
    },
    enable:function(){
        var a = document.getElementById('disable-page-mask-div');
        if(a && a.style.display!='none')a.style.display = 'none';
        JSExt.Event.Customize.triggerEvent("document_body_enable_after",a);
        return a;
    },
    isDisabled:function(){
        var a = document.getElementById('disable-page-mask-div');
        return a && a.style.display!='none';
    },
    center:function(element){
        if(typeof element === 'string')element = jQuery(element);
        var elementCount = element.length;
        if(!elementCount)return JSExt.documentBody;

        var _setPosition = function(){
            var _size = {'width':element.get(0).clientWidth,'height':element.get(0).clientHeight},_st = element.css("position")=="fixed" ? 0 : document.documentElement.scrollTop;
            var _position = {'left':document.documentElement.clientWidth/2-_size.width/2,'top':document.documentElement.clientHeight/2-_size.height/2+_st};
            element.css({'left':(_position.left<0 ? 0 : _position.left)+'px','top':(_position.top<0 ? 0 : _position.top)+'px'});
        };
        var _setMultiplePosition = function(){
            var eh = [],h = 0,bw = document.documentElement.clientWidth,bh = document.documentElement.clientHeight,left,i,j,_size,_position,top;
            var _st = element.css("position")=="fixed" ? 0 : document.documentElement.scrollTop;
            for(i = 0;i<elementCount;i++){
                if(h>0)h += 10;
                h += eh[i] = element[i].clientHeight;
            }
            top = bh/2-h/2+_st;
            for(i = 0,j = 0;i<elementCount;i++){
                _size = {'width':element[i].clientWidth,'height':eh[i]};
                _position = {'left':bw/2-_size.width/2,'top':top+j};
                if(_position.left<0)_position.left = 0;
                if(_position.top<0)_position.top = 0;
                jQuery(element[i]).css({'left':_position.left+'px','top':_position.top+'px'});
                j += _size.height+10;
            }
        };
        if(element.attr('has_add_event_listener_set_position')!=='yes'){
            jQuery(window).resize(elementCount>1 ? _setMultiplePosition : _setPosition);
            element.attr('has_add_event_listener_set_position','yes');
        }
        elementCount>1 ? _setMultiplePosition() : _setPosition();
        return JSExt.documentBody;
    }
};
JSExt.resizeImage = function(img,w,h){
    if(w<=0 || h<=0)return false;
    var imgObj = new Image(),_w,_h;
    imgObj.src = img.src;
    if(imgObj.height<=h && imgObj.width<=w){
        img.width = imgObj.width;
        img.height = imgObj.height;
        return false;
    }
    _w = Math.floor(imgObj.width*h/imgObj.height);
    _h = Math.floor(imgObj.height*w/imgObj.width);
    if(_w<=w && _h<=h){
        img.width = _w;
        img.height = _h;
    }else if(_w>w){
        img.height = _h;
        img.width = Math.floor(imgObj.width*_h/imgObj.height);
    }else if(_h>h){
        img.width = _w;
        img.height = Math.floor(imgObj.height*_w/imgObj.width);
    }
    return true;
};
JSExt.scrollIntoViewIfNeeded = function (element, options) {
    if (typeof element.scrollIntoViewIfNeeded === 'function') {
        element.scrollIntoViewIfNeeded(options);
        return;
    }

    var rect = element.getBoundingClientRect();
    var isInView = rect.top >= 0 && rect.left >= 0 && rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) && rect.right <= (window.innerWidth || document.documentElement.clientWidth);
    if (!isInView) {
        element.scrollIntoView(options);
    }
};
JSExt.loadJs = function(url){
    return new Promise((resolve, reject) => {
        if(!JSExt.loadJsCache)JSExt.loadJsCache = new Map();
        if(JSExt.loadJsCache.has(url)){
            resolve(new Event('load', {bubbles:false, cancelable:true}));
        }else{
            var script = document.createElement('script');
            script.addEventListener('load', (e) => {
                JSExt.loadJsCache.set(url, true);
                resolve(e);
            });
            script.addEventListener('error', (e) => reject(e));
            script.setAttribute('type', 'text/javascript');
            script.setAttribute('src', url);

            document.head ? document.head.appendChild(script) : document.body.appendChild(script);
        }
    });
};
