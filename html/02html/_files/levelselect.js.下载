/**
 * 可监听的事件：
 *  change: 当任何一个下拉框发生改变时触发
 *  afterCreateSelect: 当创建了一个下拉框后触发
 *  beforRemoveSelect: 一个下拉框在删掉之前触发
 *  afterRemoveSelect: 一个下拉框在删掉之后触发
 *
 * 使用例子:
 * 假如HTML已经有一个<div id="test-level-select"></div>
 * var levelSelect = new LevelSelect([['衣服',['衫','长袖','短袖'],['裤','长裤','短裤']],['1:鞋子','2:男鞋','3:女鞋']],'test-level-select','test',null,null,'--请选择--');
 * levelSelect.addEventListener('change',function(select,$this){
 *     //当任何一个下拉框发生改变时触发
 *     console.log(select.options[select.selectedIndex].value);//当前发生改的下拉框选中的值
 * });
 * levelSelect.init();//开始把下拉框都显现出来
 *
 * @param {Array} data 一个数组, 下拉框的数据, 可以使用冒号来分隔选项的值和选项的名称, 例如: ['1:鞋子','2:男鞋','3:女鞋']
 * @param {String|Array} containerId 把下拉框放在哪里, 可以是一个DIV, 也可以是INPUT, 例如: ['input1','input2','inputN...']
 * @param {String|Array} name 指定各个下拉框的name
 * @param {Array} def 各个下拉框的默认值, 可以使用冒号控制要匹配值还是名称, 例如: ['1:鞋子','2','*:女鞋'], 星号表示任意
 * @param {String|Array} className 各个下拉框的class
 * @param {String|Array} withEmpty 各个下拉框的第一个空选项的文字
 * @param {Array} eventId 事件Id ['KEY:ID1','*:ID*']
 * @returns {LevelSelect}
 */
function LevelSelect(data,containerId,name,def,className,withEmpty,eventId){
    var self = this;
    var _insert = function(e,sel){
        if(e.tagName.toLowerCase()=='input'){
            e.parentNode.insertBefore(sel,e);
            e.style.display = 'none';
            e.levelSelectElement = sel;
            sel.inputElement = e;
            $(sel).observe('change',function(event){
                e.value = this.options[this.selectedIndex].value;
                self.triggerEvent('change',this);
                self.createChild(this);
            });
        }else{
            e.appendChild(sel);
            $(sel).observe('change',function(event){
                self.triggerEvent('change',this);
                self.createChild(this);
            });
        }
        return e;
    };
    this.init = function(){
        if(this.selects.length==0 && this.data.length>0){
            this.createSelect(this.data,0);
        }
        for(var i = this.selects.length;i--;){
            if(this.selects[i].inputElement && this.selects[i].inputElement.style.display!='none'){this.selects[i].inputElement.style.display = 'none';}
        }
        return this;
    };
    this.createSelect = function(data,level,path){
        var options = [],i = 0,l = data.length,sel,withEmpty = true;
        for(;i<l; i++){
            options.push((data[i] instanceof Array) ? data[i][0] : data[i]);
        }
        if(this.withEmpty){
            if(typeof this.withEmpty=='object'){
                if(this.withEmpty[level])withEmpty = this.withEmpty[level];
            }else{
                withEmpty = this.withEmpty;
            }
        }
        sel = this.createSelectOptions(path ? path : '',options,typeof this.defaultValue[level] == 'undefined' ? '' : this.defaultValue[level],null,withEmpty);
        sel.setAttribute('ls-level',level);
        if(this.name){
            if(typeof this.name=='object'){
                sel.setAttribute('name',this.name[level] ? this.name[level] : this.name[0]+level);
            }else{
                sel.setAttribute('name',this.name+'['+level+']');
            }
        }
        if(this.className){
            if(typeof this.className=='object'){
                sel.className = this.className[level] ? this.className[level] : this.className[0]+level;
            }else{
                sel.className = this.className;
            }
        }
        if(typeof this.containerId=='string'){
            _insert(this.$(this.containerId),sel);
        }else{
            var id = typeof(this.containerId[level])=='undefined' ? this.containerId[this.containerId.length-1] : this.containerId[level];
            _insert(this.$(id),sel);
        }
        this.triggerEvent('afterCreateSelect',sel);
        if(sel.selectedIndex>0){
            if(sel.inputElement)sel.inputElement.value = sel.options[sel.selectedIndex].value;
            this.triggerEvent('change',sel);
            this.createChild(sel);
        }
        this.selects[level] = sel;
        return sel;
    };
    this.selects = [];
    this.data = (data instanceof Array) ? data : [];
    this.containerId = containerId;
    this.defaultValue = (def instanceof Array) ? def : [def];
    this.className = className;
    this.name = name;
    this.withEmpty = withEmpty;
    this.eventListener = {};
    this.eventId = {};
    if (eventId instanceof Array) {
        var arr;
        for (var _v of eventId) {
            if (_v) {
                arr = _v.split(":");
                if (arr[1]) {
                    this.eventId[arr[1]] = _v;
                }
            }
        }
    }

    //if(data && containerId){
    //    this.init();
    //}
}
LevelSelect.prototype = {
    $:function(id){return document.getElementById(id);},
    getDataByPath:function(path){
        var r = this.data;
        path = path.split('/');
        for(var i = 1;i<path.length;i++){
            if(!r[path[i]])return null;
            r = r[path[i]];
            if(typeof r == 'string')break;
        }
        return r;
    },
    getSelectedValues:function(){
        var r = [],i,l = this.selects.length;
        if(l>0){
            for(i = 0;i<l;i++){r.push(this.selects[i].options[this.selects[i].selectedIndex].value);}
        }
        return r;
    },
    createChild:function(parentSelect){
        var data,sel = false,level = parentSelect.getAttribute('ls-level'),path = parentSelect.options[parentSelect.selectedIndex].getAttribute('ls-path');
        if(level!==null){
            level = parseInt(level);
            for(var i = this.selects.length,j = 0;--i>level;j++){
                if(this.selects[i].inputElement){this.selects[i].inputElement.style.display = '';this.selects[i].inputElement.value = '';}
                this.triggerEvent('beforRemoveSelect',this.selects[i]);
                $(this.selects[i]).remove();
                this.triggerEvent('afterRemoveSelect',this.selects[i]);
            }
            if(j>0){this.selects.splice(level+1,j);}
            if(path!==null && (data = this.getDataByPath(path))!==null){
                if((data instanceof Array) && data[1]){
                    sel = this.createSelect(data.slice(1),level+1,path);
                }
            }
        }
        return sel;
    },
    destroy:function(){
        var i = this.selects.length;
        if(i>0){
            for(;i--;){
                this.triggerEvent('beforRemoveSelect',this.selects[i]);
                if(this.selects[i].inputElement){this.selects[i].inputElement.style.display = '';this.selects[i].inputElement.value = '';}
                $(this.selects[i]).remove();
                this.triggerEvent('afterRemoveSelect',this.selects[i]);
            }
            this.selects = [];

            if (this.eventId && this.eventId['region'] && this.eventId['region_id']) {
                if (document.getElementById(this.eventId['region_id'])
                        && document.getElementById(this.eventId['region'])) {
                    if (document.getElementById(this.eventId['region_id']).style.display === '') {
                        document.getElementById(this.eventId['region']).style.display = 'none';
                    }
                }
            }
        }
        return this;
    },
    addEventListener:function(name,fun){
        if(typeof(name)=='string' && typeof(fun)=='function'){
            if(typeof this.eventListener[name] != 'object')this.eventListener[name] = [];
            this.eventListener[name].push(fun);
        }
        return this;
    },
    removeEventListener:function(name,fun){
        if(typeof this.eventListener[name] == 'object'){
            for(var i = this.eventListener[name].length;i--;){
                if(this.eventListener[name][i]==fun){
                    this.eventListener[name].splice(i,1);
                }
            }
        }
        return this;
    },
    triggerEvent:function(name){
        if(typeof this.eventListener[name] == 'object'){
            var argc = arguments.length;
            for(var i = 0,len = this.eventListener[name].length;i<len;i++){
                if(argc>1){
                    var params = '';
                    for(var j = 1;j<argc;j++){params += 'arguments['+j+'],';}
                    eval('this.eventListener[name][i]('+params+'this);');
                }else{
                    this.eventListener[name][i](this);
                }
            }
        }
        return this;
    },
    createSelectOptions:function(path,options,defaultValue,select,withEmpty){
        var oOption,dv = null;
        if(select){
            select.options.length = 0;
            select.selectedIndex = -1;
        }else{
            select = document.createElement('select');
        }
        if(typeof(withEmpty)=='undefined' || (withEmpty!==false && withEmpty!==null)){
            oOption = document.createElement('option');
            select.options.add(oOption);
            oOption.value = '';
            oOption.text = (typeof withEmpty == 'undefined') ? '' : withEmpty;
        }
        if(typeof defaultValue == 'string' && defaultValue.indexOf(':')>=0){
            dv = defaultValue.split(':',2);
        }
        for(var i = 0,len = options.length,v;i<len;i++){
            oOption = document.createElement('option');
            select.options.add(oOption);
            v = options[i].split(':',2);
            oOption.text = v[1] ? v[1] : v[0];
            oOption.value = v[0];
            oOption.setAttribute('ls-path',path+'/'+(path==='' ? i : i+1));
            if(defaultValue==='*' || dv===null){
                if(defaultValue==oOption.value || defaultValue==oOption.text){
                    oOption.selected = true;
                    oOption.setAttribute('selected','selected');
                }
            }else if((dv[0]==='*' || dv[0]==oOption.value) && (dv[1]==='*' || dv[1]==oOption.text)){
                oOption.selected = true;
                oOption.setAttribute('selected','selected');
            }
        }
        return select;
    }
};