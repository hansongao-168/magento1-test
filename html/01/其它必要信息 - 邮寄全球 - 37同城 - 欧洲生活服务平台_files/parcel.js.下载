Parcel.buildRegion = function(regionJson,countryId,v){
    var show = false,rinp = document.getElementById("address:region_id"),rc = rinp ? $(rinp).up('div.el-box') : false,vname = "",rvinp = document.getElementById("address:region");
    if(rc && countryId){
        var allow = 'CA,US,CN', isAllow = allow.indexOf(countryId)>=0;
        var rr = isAllow && regionJson.config.regions_required.indexOf(countryId)>=0,ul = isAllow && regionJson[countryId] ? $(rinp).next('ul.list') : null,li;
        if(ul){
            li = ul.childElements();
            if(li.length && JSExt.isEmpty(li[0].readAttribute("value")))li.shift();
            li.invoke("remove");
            $H(regionJson[countryId]).each(function(pair){
                var li = document.createElement("li");
                ul.appendChild(li);
                $(li).writeAttribute({"class":"get-data","value":pair.key});
                li.innerHTML = pair.value.name;
                if(v && v==pair.key)vname = pair.value.name;
            });
            rc.down(".select-box").writeAttribute("style",null);
            rc.down(".region-input").writeAttribute("style","display:none;");
            rr ? $(rinp).addClassName("required-entry") : $(rinp).removeClassName("required-entry");
            vname ? rc.addClassName("canuse") : rc.removeClassName("canuse");
            show = true;
        }else if(rvinp){
            if(countryId=="CN"){
                rc.down(".select-box").writeAttribute("style","display:none;");
                rc.down(".region-input").writeAttribute("style",null);
                rvinp.value=="" ? rc.removeClassName("canuse") : rc.addClassName("canuse");
                show = true;
            }
            rr ? $(rvinp).addClassName("required-entry") : $(rvinp).removeClassName("required-entry");
        }
    }
    if(rc){
        rc.writeAttribute("style",show ? null : "display:none;");
    }
    if(rinp){
        rinp.value = vname;
        rinp.setAttribute("value-data",v || v===0 ? v : "");
    }
    //显示/隐藏城市的区
    if(countryId=="CN"){
        $("address:street1").up("div.el-box").writeAttribute("style", null);
        if (document.getElementById("address:street1").value == "-") document.getElementById("address:street1").value = "";
        if (document.getElementById("address:id_card")) {
            $("address:id_card").up("div.el-box").writeAttribute("style", null);
        }
    }else{
        $("address:street1").up("div.el-box").writeAttribute("style","display:none;");
        document.getElementById("address:street1").value = "-";
