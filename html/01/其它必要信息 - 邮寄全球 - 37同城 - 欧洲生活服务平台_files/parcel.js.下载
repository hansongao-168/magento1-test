Parcel.calculateArticlesTrTotal = function(e){
    let total_amount = 0, total_qty = 0;
    jQuery(e).find('tr').each(function () {
        let tr = this,
            q = jQuery(tr).find('input[data-key="qty"]'),
            a = jQuery(tr).find('input[data-key="amount"]');
        if (q && q[0] && a && a[0]) {
            q = parseFloat(q[0].value || 0);
            a = parseFloat(a[0].value || 0);
            total_amount += q * a;
            total_qty += q;
        }
    });

    if (total_amount) total_amount = parseFloat(total_amount.toFixed(2));

    return {
        "total_amount": total_amount + ' € HT',
        "total_qty": total_qty
    };
};

