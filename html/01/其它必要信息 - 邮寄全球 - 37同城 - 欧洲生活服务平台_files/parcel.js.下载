async function checkEmptyArticle(tr, c) {
    let isEmpty = true;
    jQuery(tr).find('input[name^="articles["],select[name^="articles["]').each(function () {
        let e = this, key = this.getAttribute("data-key") || '', value = jQuery(e).val() || '';
        if (key == 'origin_country') {
