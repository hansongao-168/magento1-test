                    }
                }else{
                    Parcel.goAdditional(url, sid, notGoAdditional);
                }
            }
            Parcel.resetLoadAdditionalTimeout();
            JSExt.Event.Customize.triggerEvent('parcelCheckAdditionalAfter', data, additional, sid, btn);
        },
        error:function(xhr){
            if(xhr.statusText==='timeout'){
                showMessages("error-msg", Translator.translate("网络超时，请重新选择"));
