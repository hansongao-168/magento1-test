Parcel.addArticle = function(btn,packageId,isCopy, data){
    var c = document.getElementById('package-articles-'+packageId),tr,index,selIndex,otr;

    if(!c)return false;

    index = JSExt.toInt(jQuery(c).attr("count"));

    if (isCopy) {
        otr = $(btn.parentNode).up("tr");
    } else {
        otr = $(c).down("tr");
    }

    tr = jQuery(otr).clone(true);

    if (index <= 0) index = 1;

    jQuery(c).append(tr);

    let isSaveData = data && Object.keys(data) && Object.keys(data).length > 0 ? true : false;

    tr.find('input[name^="articles["]').each(function(){
        var name = this.name;
        if(name.indexOf("[item_id]")>-1){
            jQuery(this).remove();
        }else{
            this.name = name.replace(/^(articles\[\d+\])\[\d+\]/,'$1['+index+']');

            if (isSaveData) {
                if (this.getAttribute("data-key") == 'origin_country') {
                    this.setAttribute("value-data", data[this.getAttribute("data-key")] ?? '');
                    this.value = data[this.getAttribute("data-key") + '_label'] ?? '';
                } else {
                    this.value = data[this.getAttribute("data-key")] ?? '';
                }
            } else {
                if (!isCopy) {
                    this.value = "";
                    if (this.hasAttribute("value-data")) this.setAttribute("value-data", "");
                }
            }

            if(otr.querySelector('input[name="'+name+'"]').dataOptions){
                this.dataOptions = otr.querySelector('input[name="'+name+'"]').dataOptions;
                jQuery(this).nextAll('ul.list').html('');
            }
            if(this.id){
                this.id = this.id.replace(/^(articles\-\d+)\-\d+\-/,'$1-'+index+'-');
            }
            if(this.next() && this.next().id){
                this.next().id = this.next().id.replace(/^(articles\-\d+)\-\d+\-/,'$1-'+index+'-');
            }
            // Parcel.setHscodesInput(this);
        }
        JSExt.Event.Customize.triggerEvent('parcelAddArticleChange', this);
        JSExt.Event.Customize.triggerEvent('parcelAddArticleBlur', this);
    });
    tr.find('.validation-failed').removeClass("validation-failed");
    tr.find('.validation-passed').removeClass("validation-passed");
    tr.find('.validation-advice').remove();
    index++;
    jQuery(c).attr("count",index);
    JSExt.Event.Customize.triggerEvent('parcelAddArticleAfter', tr);
    Parcel.setHscodes(jQuery(tr));
    Parcel.setArticles(jQuery(tr));
    return tr.get(0);
};

