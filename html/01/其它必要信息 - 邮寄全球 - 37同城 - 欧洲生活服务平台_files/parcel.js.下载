Parcel.getInputSelectBoxOption = function(inp, v, k){
    if(inp && inp.dataOptions && !!inp.dataOptions.length){
        let options = inp.dataOptions, len = options.length, i = 0;
        while(i<=len){
            if(options[i].value===v)return k ? i : options[i];
            if(options[len-1].value===v)return k ? len-1 : options[len-1];
            i++;
            len--;
        }
    }
    return null;
};
Parcel.addInputSelectBoxOption = function(inp, option, top){
    if(inp.dataOptions){
        let k = Parcel.getInputSelectBoxOption(inp, option['value'], true);
        if(k){
            inp.dataOptions[k] = option;
        }else{
            top ? inp.dataOptions.unshift(option) : inp.dataOptions.push(option);
        }
    }
    if(!inp.dataList)inp.dataList = jQuery(inp).nextAll('ul.list').get(0);
    if(inp.dataList){
        var li = jQuery(inp).children('li.get-data[value="'+option['value']+'"]').get(0);
        if(!li){
            li = document.createElement("li");
            top ? inp.dataList.insertBefore(li,inp.dataList.firstChild) : inp.dataList.appendChild(li);
        }
        li.textContent = option['label'];
        for (const k in option) {
            if(k!=='label' && option[k]!==null && option.hasOwnProperty(k))li.setAttribute(k,option[k]);
        }
        li.classList.add('get-data');
        return li;
    }
    return null;
};
Parcel.removeInputSelectBoxOption = function(inp, value){
    var k = Parcel.getInputSelectBoxOption(inp, value, true), li = jQuery(inp).nextAll('ul.list > li.get-data[value="'+value+'"]');
    if(k)inp.dataOptions.splice(k,1);
    if(li.length){
        li.remove();
        return li.get(0);
    }
    return null;
};
Parcel.addPackage = function(elm,graceful){
    var c = jQuery('#packages-container'),index = JSExt.toInt(c.attr("count")),data = {'qty':1},len = 0,elements = [],lis = [];

    jQuery(elm.parentNode).find('div,span').removeClass('validation-failed');

    jQuery(elm.parentNode).find('div,span,label').removeClass('required');
    jQuery(elm.parentNode).find('.hint').addClass('no-display');
    jQuery(elm.parentNode).find('input[name],select[name]').each(function(){
        if(this.name && !this.hasAttribute('data-favorites')){
            var v = jQuery(this).val();
            if(!JSExt.toBool(this.getAttribute('can-be-empty')) && (JSExt.isEmpty(v) || jQuery.trim(v)==="")){
                if(!graceful){
                    this.focus();
                    jQuery(this).parents('.el-box').find('.hint').removeClass('no-display');
                    jQuery(this).parent().parent().addClass('required');
                    jQuery(this).parents('.el-box').addClass('focus');
                }
                len = 0;
                return false;
            }
            if(v.indexOf(",")>-1){
                jQuery(this).val(v = v.replace(/,+/g,".").replace(/\s+/g,""));//把逗号替换成小数点
            }
            if(this.name=="qty") {
                v = JSExt.toInt(v);
                if (v <= 0) {
                    v = 1;
                    jQuery(this).val(v);
                }
            }else if(
                this.name=="platform_order_number"
                || this.name=="original_ident"
                || this.name=="artref"
                || this.name=="original_invoice_number"
                || this.name=="original_invoice_date"
                || this.name=="original_parcel_number"
            ){
                v = v.trim();
            }else if(v!==""){
                v = JSExt.toFloat(v);
                if(v<0){
                    v *= -1;
                    jQuery(this).val(v);
                }
            }
            data[this.name] = v;
            len++;
            if(this.tagName.toLowerCase()=="input"){ elements.push(this); }
        }
    });

    if(len>0){
        var volMultiple = Parcel.volMultiple || 5000;
        for(var i = 0,p;i<data.qty;i++){
            p = jQuery('#packages-container > .pack-li').get(0);
            p = index<1 ? jQuery(p) : jQuery(p).clone();
            p.find('.p-l-num').html(Translator.translate("附加保险")+': '+(JSExt.isEmpty(data.insurance_amount) || data.insurance_amount<=0 ? Translator.translate("不需要") : data.insurance_amount+'€'));
            if(typeof data.length!="undefined"){
                p.find('.p-l-l').html(data.length>0 ? data.length : "-");
                p.find('.p-l-w').html(data.width>0 ? data.width : "-");
                p.find('.p-l-h').html(data.height>0 ? data.height : "-");
                p.find('.p-l-v').html(data.length*data.width*data.height>0 ? JSExt.round(data.length*data.width*data.height/volMultiple,4) : "-");
            }
            if (index > 0) {
                c.append(p);
                jQuery(p).find('p').removeClass('required');
                jQuery(p).find('.volume ').removeClass('required');
            }
            p.removeClass('no-display');
            p.find('input[name^="packages["]').each(function(){
                var match = this.getAttribute("name").match(/\[\d*\]\[(\w+)\]$/i);
                if(match){
                    if(match[1]=='item_id'){
                        jQuery(this).remove();
                    }else{
                        this.setAttribute("name",'packages['+index+']['+match[1]+']');
                        this.value = match[1]=='qty' ? '1' : data[match[1]] ? data[match[1]] : '';
                        this.setAttribute("value",this.value);
                        if(this.getAttribute("type")!='hidden'){
                            this.setAttribute("orig-value",this.value);
                        }
                    }
                }
            });
            index++;
            c.attr("count",index);
            lis.push(p);
        }
        jQuery.each(elements,function(i,v){
            if(!v.disabled && v.getAttribute('readonly')===null){
                if (v.name == 'qty') {
                    jQuery(v).val("1").parents(".el-box");
                } else {
                    jQuery(v).val("").parents(".el-box").removeClass("canuse");
                }
            }
