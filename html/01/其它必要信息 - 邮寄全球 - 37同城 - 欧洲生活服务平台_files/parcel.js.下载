// input select动画
function initInputSelect() {
    let isinside = false;
    jQuery(document).on('focus', '.el-box input.data-box', function () {
        jQuery(this).parents('.el-box').removeClass('canuse do-nothing').addClass('focus');
    }).on('blur', '.el-box input.data-box', e => window.setTimeout(function () {
        var val = e.target.value, p = e.target.closest('.el-box'), nn = p && p.hasAttribute('no-nothing') || false;
        if (!nn && (val === undefined || val === '')) {
            jQuery(p).removeClass('canuse focus').addClass('do-nothing');
        } else {
            jQuery(p).removeClass('focus do-nothing').addClass('canuse');
        }
    }, 10));
    jQuery(document).on('focus', '.el-box input.data-keydown', function () {
        var ul = jQuery(this).nextAll('ul.list');
        if (ul.length) {
            isinside = false;
        }
        this.isSearching = false;
    }).on('mousedown', 'ul.list > li[disabled]', function(){
        isinside = true;
    }).on('blur', '.el-box input.data-keydown', function () {
        this.isSearching = false;
        if (isinside) return;
        var val = this.value;
        var p = this.closest('.el-box');
        var ul = this.dataList;
        if(ul===undefined){
            ul = this.dataList = this.parentNode.querySelector('input.data-keydown ~ ul.list');
        }
        let t = Parcel.getSelectedOption(this);
        if (t) {
            if (t.label != val) {
                this.value = val = t.label;
                this.style.backgroundColor = '#FFFFFF';
            }
        }else{
            this.setAttribute('value-data','');
            this.value = val = '';
            this.style.backgroundColor = '#FFFFFF';
        }

        jQuery(p).find('.clean').show();
        jQuery(ul).hide();
    }).on('mousedown', '.el-box .clean', function (event) {
        var pare = jQuery(this).hide().parents('.el-box');
        window.setTimeout(function () {
            pare.removeClass('focus do-nothing canuse').find('.data-box').val('').focus();
        }, 5);
        isinside = true;
        //pare.find('ul').show();
    }).on('mousedown', '.up-count', function (event) {
        isinside = true;
        jQuery(this).parents('.el-box').find('.data-box').focus();
    }).on('mouseup', '.up-count', function (event) {
        let inp = jQuery(this).parents('.el-box').find('.data-box'), ov = inp.val(), s = jQuery.isNumeric(ov) ? ov : 0,
            max = inp.attr('max');
        s++;
        if (!max || s <= max) inp.val(s);
        jQuery(this).parents('.el-box').addClass('focus');
        inp.focus();
        isinside = false;
        if (ov != inp.val()) {
            jQuery(inp).trigger("input");
        }
    }).on('mousedown', '.down-count', function (event) {
        isinside = true;
        jQuery(this).parents('.el-box').find('.data-box').focus();
    }).on('mouseup', '.down-count', function (event) {
        let inp = jQuery(this).parents('.el-box').find('.data-box'), ov = inp.val(), s = jQuery.isNumeric(ov) ? ov : 0,
            min = inp.attr('min');
        s--;
        if (min === '' && s <= 0) {
            inp.val('');
        } else if (min === '0' && s <= 0) {
            inp.val('0');
        } else if (!min || s >= min) {
            inp.val(s);
        }
        jQuery(this).parents('.el-box').addClass('focus');
        inp.focus();
        isinside = false;
        if (ov != inp.val()) {
            jQuery(inp).trigger("input");
        }
    });
}
function filterInputList(inp){
    if(window.isInputSelectBoxFiltering){
        window.clearTimeout(window.isInputSelectBoxFiltering);
    }
    window.isInputSelectBoxFiltering = window.setTimeout(function(){
        if(inp.value || inp.preValue){
            var ul = inp.dataList;
            if(ul===undefined){
                ul = inp.dataList = inp.parentNode.querySelector('input.data-keydown ~ ul.list');
            }
            if(ul){
                Parcel.fillInputSelectBox(inp, undefined, true) > 0;
                ul.setStyle({'height':'auto'});
                setInputListSize(inp, ul);
            }
            inp.preValue = inp.value;
        }
        window.isInputSelectBoxFiltering = 0;
    }, 1);
}
function setInputListSize(inp, ul){
    const inpRect = inp.getBoundingClientRect();
    let y = inpRect.top+inpRect.height+5, _h = jQuery(ul).height(), h = document.documentElement.clientHeight;
    let bh = h-inpRect.top-inpRect.height, mh = y + _h > h - 5;
    if(mh && inpRect.top>=bh && bh<=200){
        ul.style.bottom = (inpRect.height+5)+'px';
        if (_h > inpRect.top - 10) ul.style.height = (inpRect.top - 10)+'px';
    }else{
        ul.style.bottom = 'auto';
        if (mh) ul.style.height = (h - 5 - y)+'px';
    }
    if(ul.getAttribute('data-max-width')==='yes' || this.clientWidth <= 40){
        jQuery(ul).css({'width':'auto','min-width':'100%'}).find('li').css('white-space', 'nowrap');
        let x = inpRect.left, _w = ul.clientWidth, w = document.documentElement.clientWidth;
        if (x + _w > w - 15) jQuery(ul).width(w - x - 15).find('li').css('white-space', 'wrap');
    }
}
function initPopWindow() {
    jQuery(document).on('click', '.pop-window .el-button.cancel', function(event) {
        jQuery(this).parents('.pop-window').fadeOut(400, function(){
            JSExt.Event.Customize.triggerEvent('popWindowClosed', this);
        });
    }).on('click', '.pop-content', function(event) {
        event.stopPropagation();
    });
}
function openPopWindow(className) {
    var _w = className && className !== undefined
        ? className : 'pop-window', c = jQuery('.' + _w + ' .pop-content');
    jQuery('.' + _w).css('display','flex');
    c.addClass('full').css('height','auto');
    JSExt.Event.Customize.triggerEvent('popWindowOpened', jQuery('.' + _w).get(0));

    if (!className || className == 'submit-order-modal') {
        window.setTimeout(function(){
            var h = document.documentElement.clientHeight,_h = c.height();
            if(_h>h-20)c.height(h-20);
        },305);
    }
}

