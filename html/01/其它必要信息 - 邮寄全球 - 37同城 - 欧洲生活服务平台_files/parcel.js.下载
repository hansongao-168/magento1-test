Parcel.initGoogleAutocomplete = function (country_id) {
    let input = document.getElementById('address:street2'),
        countryElm = document.getElementById('address:country_id'),
        country = country_id || countryElm && countryElm.getAttribute('value-data') || 'FR';

    if (country == 'NB' || country == 'SF' || country == 'EN' || country == 'WL') {
        country = 'GB';
    }

    if (googleAutocomplete) {
        googleAutocomplete.setComponentRestrictions({
            country: country
        });
    }

    if (typeof(google) === 'undefined' || googleAutocomplete) return this;

    const options = {
        componentRestrictions: { country: country },
        fields: ['address_components', 'geometry', 'name', 'formatted_address'],
        // types: ['address'],
    };
    googleAutocomplete = new google.maps.places.Autocomplete(input, options);

    googleAutocomplete.addListener('place_changed', function () {
        let place = googleAutocomplete.getPlace(),
            street2 = '', postcode = '', city = '', district = '', region = '';
        for (let component of place.address_components) {
            let componentType = component.types[0];
            switch (componentType) {
                case 'street_number': {
                    street2 = `${component.long_name} ${street2}`;
                    break;
                }
                case 'route': {
                    street2 += component.short_name;
                    break;
                }
                case 'postal_code_prefix':
                case 'postal_code':{
                    postcode = `${component.long_name}${postcode}`;
                    break;
                }
                case 'locality':
                    case 'neighborhood':
                    if (
                        !document.getElementById('address:city').value
                        || place.formatted_address.indexOf(component.long_name) > 0
                    ) {
                        city = component.long_name;
                    }
                    break;
                case 'sublocality_level_1':
                    district = component.long_name;
                    break;
                case 'administrative_area_level_1':
                    region = component.long_name;
                    break;
            }
        }
        // input.value = street2;
        // jQuery('[id="address:postcode"]').val(postcode);
        // jQuery('[id="address:city"]').val(city);
console.log(place);
        input.value = Parcel.str_replace(street2);
        jQuery('[id="address:postcode"]').val(postcode);
        jQuery('[id="address:city"]').val(Parcel.str_replace(city));

        for(let elm of [jQuery('[id="address:postcode"]'), jQuery('[id="address:city"]')]) {
            if(!!elm.closest('.el-box').length) {
                elm.closest('.el-box').addClass('canuse');
            }
        }
    });
    return Parcel;
};

