Parcel.showProductCustomOptionNote = function(elm,price,sid,showFree){
    var div = elm.optionNoteElement,
        iSel = elm.tagName.toLowerCase() == "select",
        opt = iSel ? elm.options[elm.selectedIndex] : false,
        note;
    if(opt){
        if(price===undefined || price===null)price = JSExt.toFloat(opt.getAttribute("price"));
    }else if(elm.getAttribute("type")=="checkbox"){
        if(price===undefined || price===null)price = elm.checked ? JSExt.toFloat(elm.getAttribute("price")) : 0;
    }

    if (price && Parcel.fuelPercent) {
        price += price * Parcel.fuelPercent;
        price = Math.round(price * 100) / 100;
    }

    if(price !== undefined && price!=0){
        note = price<0 ? '- ' : '+ ';
        note += Parcel.priceFormat.replace(/0[\.\,]00/,JSExt.round(price,2,true))+" HT";
    }

    if (showFree && price == 0) {
        note = " (Offert)";
    }

    if(!div)div = $(elm).next();
    if(!div || !div.hasClassName('option-note'))div = $(elm.parentNode).next();
    if(note){
        if (iSel) {
            elm.parentNode.addClassName('input-group').addClassName('d-flex').addClassName('align-items-center');
        }

        if(!div || !div.hasClassName('option-note')){
            var label = $(elm).next("label");
            if(!label && elm.parentNode.tagName.toLowerCase()=="label")label = elm.parentNode;
            div = document.createElement('span');
            if (iSel) {
                div.setAttribute('class', 'option-note position-absolute start-50');
            } else {
                div.setAttribute('class', 'option-note');
            }
            div.innerHTML = note+'&nbsp;/&nbsp;colis';
            $(label ? label : elm).insert({after: div});
            elm.optionNoteElement = div;
        }else{
            div.innerHTML = note+'&nbsp;/&nbsp;colis';
            div.show();
        }
    }else if(div && div.hasClassName('option-note')){
        div.hide();
        if (iSel) {
            elm.parentNode.removeClassName('input-group').removeClassName('d-flex').addClassName('align-items-center');
        }
    }

    Parcel.ajaxCarrierTotals(sid);

    return Parcel;
};

Parcel.submitAdditional = function(btn,url,sig){
    var validator  = new Validation("parcel-additional-form",{onSubmit:false,immediate:false});
    var params = Form.serialize("parcel-additional-form", true), error = [];
    jQuery('#parcel-additional-form input[value-data]').each(function () {
        if (this.name) params[this.name] = this.getAttribute("value-data");
    });

    if(!sig && document.getElementById("signature_image") && typeof drawSignature=="object"){
        btn.disabled = true;
        drawSignature.toBase64(function(s1,s2){
            document.getElementById("signature_image").value = s2;
            btn.disabled = false;
            Parcel.submitAdditional(btn,url,true);
        });
        return Parcel;
    }

    if (validator.validate()) {
        if (error.length) {
            showMessages("error-msg", error.join("<br />"));
        } else {
            var isOk = false;
            btn.disabled = true;
            jQuery.ajax({
                type: "POST", url: url, processData: true, data: params, dataType: "json",
                success: function (data) {
                    if (data) {
                        if (data.success) {
                            isOk = true;
                            window.location.href = data.redirect ? data.redirect : "../intros/";
                        } else {
                            Parcel.submitSaveArticles(params);
                            showMessages("error-msg", data.message ? data.message : "保存包裹出错了");
                        }
                    } else {
                        Parcel.submitSaveArticles(params);
                    }
                },
                error: function () {
                    Parcel.submitSaveArticles(params);
                    showMessages("error-msg", "保存包裹信息时服务器出错了");
                },
                complete: function () {
                    if (!isOk) btn.disabled = false;
                }
            });
        }
    } else {
        Parcel.submitSaveArticles(params);

        showMessages("error-msg", Parcel.showRequiredMessages() + ' 02');
    }
    return Parcel;
};

Parcel.submitSaveArticles = function (params) {
    if (Parcel.SaveArticlesUrl) {
        jQuery.ajax({
            type: "POST", url: Parcel.SaveArticlesUrl, processData: true, data: params, dataType: "json",
            success: function (data) {
                if (data) {
                    if (data.success) {
                        console.log("Update Success");
                    } else {
                        console.log(data.message ? data.message : "保存包裹出错了");
                    }
                }
                return false;
            }
        });
    }
    return Parcel;
};

