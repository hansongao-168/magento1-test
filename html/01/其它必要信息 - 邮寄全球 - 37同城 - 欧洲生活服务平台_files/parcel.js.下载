Parcel.checkAdditional = function (btn, url, aUrl, sid, notGoAdditional) {
    var isOk = false;
    var additional = Parcel.getAdditionalElement();
    jQuery(additional).parent().attr("style", "display:none !important");
    jQuery.ajax({type:"POST",url:aUrl,processData:true,data:"shipping="+sid,dataType:"json",timeout:btn.isInitAction ? 0 : Parcel.getLoadAdditionalTimeout(),
        success:function(data){
            if(data){
                if (data.is_back_url) {
                    if(typeof data.is_back_url==='string' && data.is_back_url.indexOf('http')===0){
                        window.location.href = data.is_back_url;
                    }else{
                        jQuery(".el-button.back").click();
                    }
                    return false;
                }

                if(data.success){
                    Parcel.carrierId = sid;
                    isOk = true;
                    if (data.step_additional) {
                        Parcel.goAdditional(url, sid, notGoAdditional);
                    } else {
                        if (data.additional_html) {
