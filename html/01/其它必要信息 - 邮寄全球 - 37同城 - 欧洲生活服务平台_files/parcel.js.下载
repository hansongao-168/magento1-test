Parcel.submitPackage = function(btn,url,nexUrl){
    Parcel.addPackage(document.getElementById("add-package-button"),true);

    if(JSExt.toInt(jQuery('#packages-container').attr("count"))>0){
        var c = document.getElementById('packages-container');
        var eventData = {params:Form.serialize(c,true),needSubmit:false,checkRequired:true,canSubmit:true};

        jQuery(c).trigger('onSubmitPackage', [eventData]);
        if(!eventData.canSubmit)return Parcel;

        var p = eventData.params,
            p2 = {},
            needSubmit = eventData.needSubmit,
            checkRequired = eventData.checkRequired;
        jQuery(c).find('.volume').removeClass('required');
        jQuery.each(p,function(k,v){
            var match = k.match(/(.+)\[(\w+)\]$/i),inp,inp2;

            if(match){
                inp = jQuery('input[type="text"][name="'+k+'"]',c);
                inp2 = jQuery('input[type="hidden"][name="'+k+'"]',c);

                if (jQuery(inp2).hasClass('required-entry')) {
                    var dataKey = jQuery(inp2).attr('data-key');
                    if (dataKey) {
                        jQuery('span[data-' + dataKey + ']').each(function(k1, v1) {
                            if (!jQuery(v1).html() || jQuery(v1).html() == '-') {
                                jQuery(v1).parent().parent().parent().addClass('required');
                                checkRequired = false;
                            }
                        });
                    }
                }

                if(!p2[match[1]])p2[match[1]] = {};
                if(!p2[match[1]]['is_modified'] && inp.attr('orig-value')!=inp.val())p2[match[1]]['is_modified'] = true;
                if(!p2[match[1]]['is_modified'] && inp2.attr('orig-value')!==undefined && inp2.attr('orig-value')!=inp2.val())p2[match[1]]['is_modified'] = true;
                p2[match[1]][match[2]] = v;
            }
        });

        jQuery('.parcel-package .el-box').removeClass('required');
        jQuery('.parcel-package .el-box .hint').addClass('no-display');

        if (!checkRequired) {
            return Parcel;
        }

        p = {"form_key":p.form_key || ""};
        jQuery.each(p2,function(k,v){
            if(!v.item_id || v.item_id==0 || v.is_modified){
                jQuery.each(v,function(_k,_v){
                    if(_k!="is_modified")p[k+"["+_k+"]"] = _v;
                });
                needSubmit = true;
            }
        });

        if(needSubmit){
            var isOk = false;
            btn.disabled = true;
            jQuery.ajax({type:"POST",url:url,processData:true,data:p,dataType:"json",
                success:function(data){
                    if(data){
                        if(data.success){
                            isOk = true;
                            window.location.href = data.redirect ? data.redirect : nexUrl;
                        }else{
                            showMessages("error-msg",data.message ? data.message : "保存包裹出错了");
                        }
                    }
                },
                error:function(){showMessages("error-msg","保存包裹信息时服务器出错了");},
                complete:function(){ if(!isOk)btn.disabled = false; }
            });
        }else{
            window.location.href = nexUrl;
        }
    }else{
        //showMessages("error-msg",Translator.translate("至少要填写一个包裹"));
        Parcel.addPackage(document.getElementById("add-package-button"),false);
    }
    return Parcel;
};
