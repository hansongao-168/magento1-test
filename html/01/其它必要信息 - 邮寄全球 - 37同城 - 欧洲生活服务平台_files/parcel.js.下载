Parcel.selectChangeEvent = function(event) {
    if(this.hasAttribute('disabled'))return Parcel;
    var inp = $(this).up('ul').previous('.data-box'), v = this.getAttribute('value');
    if (inp) {
        inp.value = this.innerText;
        if (v !== undefined && v !== null) {
            inp.setAttribute('value-data', v);
        }
        var k = inp.getAttribute('id') || inp.getAttribute('name'), ev = inp.getAttribute('on-change');
        if (k) JSExt.Event.Customize.triggerEvent(k + "_change", inp);
        if (ev) {
            eval(ev.replace(/\bthis\b/gi, 'inp').replace(/\boption\b/gi, 'this'));
        }
    }
    return Parcel;
};

Parcel.saveQuoteAddress = function(id,type){
    var url = jQuery("#parcel-address-container").attr("save-url"),
        defShippingUrl = jQuery("#parcel-address-container").attr("save-def-shipping-url");
    if(id && url){
        jQuery.ajax({type:"POST",url:url,data:"id="+id+"&type="+type,dataType:"json",
            success:function(data){
                if(data){
                    if(data.success){
                        var c = document.getElementById(data.address_type+"_address_html");
                        if(c)c.innerHTML = (data.edit_button ? data.edit_button : "")+'<div class="address-html">'+data.address_html+'</div>';
                        if (type == 'billing' && data.has_update_de_shipping) {
                            Parcel.showCountry = "FR";
                            Parcel.clearShippingAddress();
                        } else {
                            Parcel.showCountry = null;
                            jQuery("#default-shipping-address").addClass("no-display");
                            if (!jQuery('input[name="consignee_pay"]:checked',document.getElementById("express-parcel-create-container")).val()) {
                                jQuery('div[address-type="shipping"]',document.getElementById("parcel-address-container")).removeClass("no-display");
                            }
                            if(document.getElementById("invoice-address-container"))jQuery("#invoice-address-container").removeClass("no-display");
                            jQuery('#default_shipping_address_id').attr('value-data', '');
                        }
                        JSExt.Event.Customize.triggerEvent('afterSavedQuoteAddress', data);
                    }else{
                        showMessages("error-msg",data.message ? data.message : "保存地址出错了");
                        if(data.address_data){
                            var cb = function(){
                                Parcel.showEditAddressForm(data.address_data);
                                JSExt.Event.Customize.removeEventListener("document_body_enable_after",cb);
                            };
                            JSExt.Event.Customize.addEventListener("document_body_enable_after",cb);
                            if(!data.address_data.address_type || data.address_data.address_type=="")data.address_data.address_type = data.address_type;
                        }
                    }
                }
            },
            error:function(){showMessages("error-msg","保存地址服务器出错了");}
        });
    }
    return Parcel;
};
Parcel.getPickupAddress = function(id,type){
    var url = jQuery("#parcel-address-container").attr("save-url");
    if (id && url) {
        var shippingMethodElm = jQuery('input[name="pickup_shipping_method"]:checked'), shippingMethod = null;
        if (shippingMethodElm && shippingMethodElm[0] && jQuery(shippingMethodElm[0]).val()) {
            shippingMethod = jQuery(shippingMethodElm[0]).val();
        }
        jQuery.ajax({type:"POST",url:url,data:"id="+id+"&type="+type+'&pickup_shipping_method=' + shippingMethod,dataType:"json",
            success:function(data){
                jQuery('#pickup_address_error').addClass('no-display');
                jQuery('.pickup_date_wrapper,.packages-detail').removeClass('no-display');
                jQuery('.pickup_date_wrapper,.pickup_date_title_wrapper').removeClass('d-none');
                if(data){
                    if(data.success){
                        var c = document.getElementById(data.address_type+"_address_html");
                        if(c)c.innerHTML = (data.edit_button ? data.edit_button : "")+'<div class="address-html">'+data.address_html+'</div>';
                    }else{
                        if(data.address_data){
                            var cb = function(){
                                Parcel.showEditAddressForm(data.address_data);
                                JSExt.Event.Customize.removeEventListener("document_body_enable_after",cb);
                            };
                            JSExt.Event.Customize.addEventListener("document_body_enable_after",cb);
                            if(!data.address_data.address_type || data.address_data.address_type=="")data.address_data.address_type = data.address_type;
                        }

                        if (data.error) {
                            var errorElm = jQuery('#pickup_address_error').find('span') || '';
                            if (errorElm && errorElm[0]) {
                                var c = document.getElementById(data.address_type+"_address_html");
                                if(c)c.innerHTML = (data.edit_button ? data.edit_button : "")+'<div class="address-html">'+data.address_html+'</div>';
                                jQuery(errorElm[0]).html(data.error);
                                jQuery('#pickup_address_error,.pickup_date_wrapper,.packages-detail').removeClass('no-display');
                                jQuery('.pickup_date_wrapper,.packages-detail').addClass('no-display');
                                jQuery('.pickup_date_wrapper,.pickup_date_title_wrapper').addClass('d-none');
                                return Parcel;
                            }
                        }

                        showMessages("error-msg",data.message ? data.message : "保存地址出错了");
                    }

                    if (document.getElementById('_pickup_address_id')) {
                        document.getElementById('_pickup_address_id').value = data.address_id || '';
                    }
                    if (document.getElementById('pickup_amount')) {
                        document.getElementById('pickup_amount').value = data.pickup_amount || 0;
                        jQuery(document.getElementById('pickup_amount')).change();
                    }

                    Parcel.updatePickupDateHtml(shippingMethod, data.pickup_date_html);
                }
            },
            error:function(){showMessages("error-msg","保存地址服务器出错了");}
        });
    }
    return Parcel;
};

Parcel.getPickupDate = function (code, url) {
    if (code && url) {
        jQuery.ajax({
            type: "POST",
            url: url,
            data: "code=" + code,
            dataType: "json",
            success: function (data) {
                if (data && data.pickup_date_html) {
                    Parcel.updatePickupDateHtml(code, data.pickup_date_html);
                    return Parcel;
                }
                showMessages("error-msg", data.message ? data.message : "获取失败");
            },
            error: function () {
                showMessages("error-msg", "获取失败");
            }
        });
    }
    return Parcel;
}

Parcel.updatePickupDateHtml = function (code, content) {
    var pickupDateElm = document.querySelector("div[data-model=\"pickup_date\"]");
    if (pickupDateElm) {
        jQuery(pickupDateElm).attr('data-code', code);
        jQuery(pickupDateElm).html(content || '');
    }
    return Parcel;
}

Parcel.showEditAddressForm = function(data,btn){
    if(typeof data == "string"){
        if(btn.isLoading)return Parcel;
        var btxt = btn.innerHTML;
        btn.innerHTML = Translator.translate("Loading");
        btn.isLoading = true;
        jQuery.ajax({type:"POST",url:data,dataType:"json",
            success:function(result){
                if(result){
                    if(result.success){
                        Parcel.showEditAddressForm(result.address,btn);
                    }else{
                        showMessages("error-msg",result.message ? result.message : "获取地址出错了");
                    }
                }
            },
            error:function(){showMessages("error-msg","获取地址时服务器出错了");},
            complete:function(){ btn.innerHTML = btxt;btn.isLoading = false; }
        });
        return Parcel;
    }
    var form = document.getElementById("address-edit-form");
    if(!data || !jQuery.isPlainObject(data))data = {};
    if(!data.country_id)data.country_id = 'FR';
    if(!data.prefix)data.prefix = 'Mister';
    if(!data.street)data.street = ["-",""];
    else if(!data.street[0])data.street[0] = "-";
    if(data.country_id=="CN" && data.street[0]=="-")data.street[0] = "";

    openPopWindow(jQuery(btn).attr('data-pop-window'));

    var countries = Parcel.shipperCountries;
    if (data.address_type == 'shipping') {
        countries = Parcel.receiverCountries;
    } else if (data.address_type == 'invoice') {
        countries = Parcel.invoiceCountries;
    }
    if(countries){
        Parcel.fillInputSelectBox(document.getElementById("address:country_id"),countries);
    }
    if(typeof RegionJson !=="undefined")Parcel.buildRegion(RegionJson,data.country_id);
    jQuery('input.data-box[type="text"],input[type="hidden"]',form).each(function(){
        var match;

        if (this.id == 'address:delivery_instructions') {
            var elm = jQuery(this).parent().parent().parent();
            if (data.address_type != 'shipping') {
                jQuery(elm).removeClass('d-flex').addClass('d-none');
            } else {
                jQuery(elm).removeClass('d-none').addClass('d-flex');
            }
        }

        if(this.name && (match = this.name.match(/\w+\[([^\[\]]+)\](?:\[([^\[\]]+)\])?/))){
            if(match[2]!==null && match[2]!==undefined){
                this.value = data[match[1]] && data[match[1]][match[2]] ? data[match[1]][match[2]] : '';
            }else{
                this.value = data[match[1]] ? data[match[1]] : '';
            }
            if(this.getAttribute("type")!="hidden"){
                this.value=="" ? jQuery(this).parents('.el-box').removeClass('canuse') : jQuery(this).parents('.el-box').addClass('canuse');
                if(this.value!=""){
                    var ul = jQuery(this).nextAll('ul.list');
                    if(ul.length){
                        this.setAttribute("value-data",this.value);
                        this.value = JSExt.toString(ul.children('li.get-data[value="'+this.value+'"]').text());
                    }
                }
            }
        }
    });
    if(window.levelSelect){
        window.levelSelect.destroy();
        if(data.country_id=="CN"){
            window.levelSelect.defaultValue[0] = data.region;
            window.levelSelect.defaultValue[1] = data.city;
            window.levelSelect.defaultValue[2] = '*:'+data.street[0];
            window.levelSelect.init();
        }
    }
    Parcel.initGoogleAutocomplete(data.country_id);

    if (typeof setSmartParseAddressPlaceholder === 'function') setSmartParseAddressPlaceholder(data.country_id);

    Parcel.addressValidation();

    return Parcel;
};

