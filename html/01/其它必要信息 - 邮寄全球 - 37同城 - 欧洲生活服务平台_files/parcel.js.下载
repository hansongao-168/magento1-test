Parcel.getArticleTotals = function(){
    var totals = {};
    if(Parcel.packageIds){
        var qty,amount,weight,q,a,w;
        for(var i = 0,len = Parcel.packageIds.length,c,tr;i<len;i++){
            if(c = document.getElementById('package-articles-'+Parcel.packageIds[i])){
                qty = amount = weight = 0;
                tr = $(c).down("tr");
                while(tr){
                    q = a = w = 0;
                    tr.select('input[name]').each(function(inp){
                        var match = inp.name ? inp.name.match(/(\w+)\[(\d+)\]\[(\d*)\]\[(\w+)\]/i) : null;
                        if(match && match[2]==Parcel.packageIds[i]){
                            if(match[4]=="qty")q = Math.abs(JSExt.toFloat(inp.value));
                            else if(match[4]=="amount")a = Math.abs(JSExt.toFloat(inp.value));
                            else if(match[4]=="weight")w = Math.abs(JSExt.toFloat(inp.value));
                        }
                    });
                    qty += q;
                    amount += q*a;
                    weight += q*w;
                    tr = tr.next();
                }
                totals[Parcel.packageIds[i]] = {"qty":qty,"amount":amount,"weight":weight};
            }
        }
    }
    return totals;
};
