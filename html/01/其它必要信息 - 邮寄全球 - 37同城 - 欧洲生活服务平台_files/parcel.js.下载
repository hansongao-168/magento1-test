Parcel.fillInputSelectBox = function(inp,options,filter){
    var i = 0;
    if(inp){
        if(!inp.dataList)inp.dataList = jQuery(inp).nextAll('ul.list').get(0);
        if(!inp.dataList)return i;

        var li, listLimit = inp.dataList.getAttribute('list-limit'), loading = jQuery(inp.dataList).children('.loading');
        var fragment = document.createDocumentFragment();
        var kw = filter || inp.isSearching ? inp.value : '';
        var isFilterCountry = Parcel.showCountry && inp.dataList.getAttribute('filter-country')==='true';
        if(options && typeof options === 'object'){
            inp.dataOptions = options;
        }else{
            options = inp.dataOptions ? inp.dataOptions : [];
        }
        inp.dataList.innerHTML = '';
        for(const option of options){
            if(listLimit && listLimit!=='0' && i>=listLimit){
                break;
            }
            li = document.createElement("li");
            li.textContent = option['label'];
            if((!isFilterCountry || Parcel.showCountry==option['data-country']) && (kw==='' || Parcel.isMatchInputSelectBoxOption(kw,li))){
                for (const k in option) {
                    if(k!=='label' && option[k]!==null && option.hasOwnProperty(k))li.setAttribute(k,option[k]);
                }
                fragment.appendChild(li);
                li.classList.add('get-data');
                i++;
            }
        }
        if(i){
            inp.dataList.appendChild(fragment);
            if(kw!=='')inp.style.backgroundColor = '#fff';
        }else if(kw!==''){
            inp.style.backgroundColor = '#f66';
        }
        if(loading.length)inp.dataList.appendChild(loading[0]);
    }
    return i;
};
Parcel.isMatchInputSelectBoxOption = function(kw,li){
    var text = li.innerText;
    var s = kw + '~|~' + text;
    s = Parcel.str_replace(s);
    s = s.split('~|~');
    var isMatch = s[1].toUpperCase().indexOf(s[0].toUpperCase())>=0;
    if(isMatch){
        li.innerHTML = s[1].replace(new RegExp('('+s[0].replace(/([\|\$\(\)\*\+\.\[\]\?\\\^\{\}])/g,'\\\\$1')+')','i'),'<span style="background-color:#f15a24;color:#FFFFFF;">$1</span>');
    }
    return isMatch;
};
Parcel.getSelectedOption = function(inp, k){
    var v = inp.getAttribute('value-data');
