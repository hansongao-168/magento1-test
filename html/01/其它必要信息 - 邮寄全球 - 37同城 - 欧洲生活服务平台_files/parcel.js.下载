Parcel.articleValidate = function (validator, elm) {
    var result = false;
    var useTitles = validator.options.useTitles;
    var callback = validator.options.onElementValidate;

    try {
        if (elm.hasClassName('local-validation') && !validator.isElementInForm(elm, validator.form)) {
            return true;
        }
        result = Validation.validate(elm, {useTitle: useTitles, onElementValidate: callback});
    } catch (e) {
    }

    if (!result && validator.options.focusOnError) {
        try {
            $(elm).hasClassName('validation-failed').first().focus();
        } catch (e) {
        }
    }
    validator.options.onFormValidate(result, validator.form);
    return result;
};

