Parcel.paramsToArray = function(params){
    var arr = {};
    jQuery.each(params,function(key,value){
        var match = key.match(/^([^\[\]]+)\[/),re,_match,_match1 = key.match(/\[([^\[\]]+)\]$/),tmp;
        if(match && _match1){
            if(typeof arr[match[1]] === "undefined")arr[match[1]] = {};
            re = /\[(\w+)\]/g;
            tmp = arr[match[1]];
            while((_match = re.exec(key)) !== null){
                if(typeof tmp[_match[1]] === "undefined")tmp[_match[1]] = {};
                if(_match1[1]==_match[1]){
                    tmp[_match[1]] = value;
                }else{
                    tmp = tmp[_match[1]];
                }
            }
        }else{
            arr[key] = value;
        }
    });
    return arr;
};
