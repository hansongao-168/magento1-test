            _q = JSExt.toFloat(jQuery(this).parents('.pack-li').find('input[name^="packages["][name$="][qty]"]').val()) || 1;
            a += JSExt.toFloat(this.value) * _q;
        }else if(name.indexOf("[qty]")>0){
            q += JSExt.toFloat(this.value);
        }
    });
    if(q<=0){
        jQuery('.pack-mes',document.getElementById("express-parcel-create-container")).removeClass('move');
    }else{
