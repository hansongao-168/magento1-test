var FVILLE_BE = [];
function postCodeCityRelation(input,isCity,country,saveInput){
    this.data = FVILLE;
    this.inputElement = $(input);
    this.saveInputElement = saveInput;
    this.saveInputElementDiv = saveInput && (saveInput + ':div') || '';
    this.isCity = isCity;
    this.countryElement = $(country);
    this.maxListCount = 20;
    this.ul = null;
    this._tid = 0;
    this._onSelected = [];
    var self = this;
    var _onInput = function(){
        var v = this.value;
        if($F(self.countryElement)=="FR"){
            self.data = FVILLE;
            self.showList(v);
        } else if($F(self.countryElement)=="BE"){
            self.data = FVILLE_BE;
            self.showList(v);
        }
    };
    var _onBlur = function(){
        if(self._tid!==false){
            self._tid = window.setTimeout(function(){self.showList(false);self._tid = 0;},20);
        }else{
            self._tid = 0;
        }
    };
    this.inputElement.observe('input',_onInput);
    this.inputElement.observe('focus',_onInput);
    this.inputElement.observe('blur',_onBlur);
    this.inputElement.writeAttribute('autocomplete','new-password');
}
postCodeCityRelation.prototype = {
    _createList:function(data){
        var i = 0,j = 0,len = data.length,html = '';
        for(;i<len;i++){
            html += '<li style="padding:0;margin:0;line-height:100%;cursor:default;white-space:nowrap;border-top:1px solid #F2F2F2" data-index="'+i+'">';
            for(j = 0;j<data[i].length;j++){
                html += '<span style="display:inline-block;padding:10px 6px;line-height:100%;">'+data[i][j]+'</span>';
            }
            html += '</li>';
        }
        return html;
    },
    _setOffset:function(){
        var a = this.inputElement.positionedOffset(),b = this.inputElement.getDimensions();
        $(this.getUl()).setStyle({"min-width":b.width+"px","top":(b.height+a.top)+"px","left":b.left+"px"});
        return this;
    },
    _addEvent:function(){
        var self = this;
        $(this.getUl()).select("li").each(function(li){
            $(li).observe("click",function(){
                var i = this.getAttribute("data-index");
                if ($(self.saveInputElement)) {
                    $(self.saveInputElement).value = self.getUl().useData[i][0];         
                    if(!$(self.saveInputElementDiv).hasClassName("no-display")) $(self.saveInputElementDiv).addClassName("no-display");
                } else {
                    self.inputElement.value = self.getUl().useData[i][0];
                }
                self._triggerEvent(self.getUl().useData[i]);
                self.showList(false);
                if(self._tid){window.clearTimeout(self._tid);self._tid = 0;}
            });
            $(li).observe("mousedown",function(){
                if(self._tid){window.clearTimeout(self._tid);self._tid = 0;}
                else self._tid = false;
            });
        });
        return this;
    },
    _triggerEvent:function(data){
        for(var i = 0,len = this._onSelected.length;i<len;i++){
            this._onSelected[i](data,this);
        }
        return this;
    },
    onSelected:function(fun){
        if(typeof fun === "function"){
            this._onSelected.push(fun);
        }
        return this;
    },
    getUl:function(){
        if(!this.ul){
            this.ul = document.createElement("ul");
            $(this.ul).setStyle({"position":"absolute","z-index":99,"background-color":"#FFF","border":"1px solid #cccccc","overflow-y":"scroll","max-height":"350px"});
            this.inputElement.insert({after:this.getUl()});
        }
        return this.ul;
    },
    showList:function(value){
        var _data = [];
        if(value || value==='0'){
            var i = 0,l = this.data.length;
            for(;i<l;i++){
                if(this.isCity){
                    if(this.data[i][1].toUpperCase().indexOf(value.toUpperCase())===0)_data.push([this.data[i][1],this.data[i][0]]);
                }else if(this.data[i][0].toUpperCase().indexOf(value.toUpperCase())===0){
                    _data.push([this.data[i][0],this.data[i][1]]);
                }
                if(_data.length>=this.maxListCount)break;
            }
        }
        if(_data.length>0){
            this.getUl().useData = _data;
            this.getUl().innerHTML = this._createList(_data);
            $(this.getUl()).show();
            this._setOffset();
            this._addEvent();
        }else if(this.ul){
            this.ul.innerHTML = "";
            $(this.ul).hide();
        }
        return this;
    },
    setMaxListCount:function(count){
        this.maxListCount = parseInt(count);
        if(isNaN(this.maxListCount) || this.maxListCount<1){
            this.maxListCount = 1;
        }
        return this;
    }
};
function createInputRelation(input, isCity, country, setInput) {
    var sel = input + ':sel',selD = input + ':div';
    if (!document.getElementById(sel)) {
        var inputElementDiv = document.createElement("div"),inputElement = document.createElement("input"),a = $(input).positionedOffset(),b = $(input).getDimensions();
        $(inputElementDiv).id = selD;
        $(inputElement).id = sel;
        $(inputElement).autocomplete = "new-password";
        $(inputElement).setStyle({"min-width":b.width + "px", "top":(b.height+a.top) + "px", "left":b.left + "px"});
        $(inputElementDiv).append($(inputElement));
        $(input).after($(inputElementDiv));
    }
    $(selD).className = "no-display";
    var selRelation = new postCodeCityRelation(sel, isCity, country, input);
    selRelation.onSelected(function(data){
        if (typeof data[1] !=="undefined") document.getElementById(setInput).value = data[1];
    });
    $(input).parentNode.observe("mouseover", function(){
        if($(selD).hasClassName("no-display")) $(selD).removeClassName("no-display");
    });
    $(input).parentNode.observe("mouseout", function(){
        if(!$(selD).hasClassName("no-display")) $(selD).addClassName("no-display");
    });
}
